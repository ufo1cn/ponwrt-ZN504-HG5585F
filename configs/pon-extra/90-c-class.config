# configs/pon-extra/90-c-class.config —— C 类外挂包（旧仓库专用 app）
#
# 仅由 .github/workflows/build-packages-extra.yml 合并进 .config；
# 这里全部 =m（产物是独立 apk），不进固件镜像。
#
# mihomo-meta / mihomo-alpha 不写在这里：二者互 PROVIDES/CONFLICTS，
# 由工作流按 inputs.mihomo 在 defconfig 之后单独追加其中一个。

# ---- IPTV：kmod-iptv 提供 itv 单设备（service_vid + mcast_vid 解复用）----
CONFIG_PACKAGE_kmod-iptv=m
CONFIG_PACKAGE_luci-app-iptv=m
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=m

# ---- 组播代理：kmod-iptv 只做 VLAN 解复用，转发交给 omcproxy ----
CONFIG_PACKAGE_omcproxy=m
CONFIG_PACKAGE_luci-app-omcproxy=m

# ---- nikki（eBPF 透明代理）+ mihomo 内核虚拟名 ----
CONFIG_PACKAGE_nikki=m
CONFIG_PACKAGE_luci-app-nikki=m
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=m

# ---- passwall2：核心只锁 Xray，禁止 select 到 SingBox/All 造成重复集成 ----
CONFIG_PACKAGE_luci-app-passwall2=m
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=n
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All=n
CONFIG_PACKAGE_xray-core=m

# ---- homeproxy（sing-box 内核已在 release.config 选为 =y）----
CONFIG_PACKAGE_luci-app-homeproxy=m

# ---- lyaml：luci-app-passwall2 的硬依赖（工作流从 openwrt-24.10 注入）----
CONFIG_PACKAGE_lyaml=m
CONFIG_PACKAGE_libyaml=m

# ---- honk：eBPF 透明代理（上游镜像自带，这里只出 apk，装不装由机型决定）----
CONFIG_PACKAGE_honk=m
CONFIG_PACKAGE_luci-app-honk=m
CONFIG_PACKAGE_luci-i18n-honk-zh-cn=m

# ---- passwall2 硬依赖补全：libuci-lua 由 base 的 uci 包组出，之前靠依赖自动选中，
#      显式列出保证每次 extra 流都编出来并发布进仓库（lyaml/libyaml/unzip 已在上面/§8）----
CONFIG_PACKAGE_libuci-lua=m

# ---- OpenClash：不进镜像，只出独立 apk（核心不打包，运行期由 luci 下载）
#      用户态依赖显式列出，否则 kconfig 判定依赖不满足会把 luci-app-openclash 丢掉
#      内核侧 kmod-tun/kmod-nft-tproxy/kmod-inet-diag 由固件流提供
CONFIG_PACKAGE_luci-app-openclash=m
CONFIG_PACKAGE_bash=m
CONFIG_PACKAGE_ruby=m
CONFIG_PACKAGE_ruby-yaml=m
CONFIG_PACKAGE_unzip=m

# ---- SQM：不进镜像，只出独立 apk
#      tc 走 tc-tiny（PROVIDES:=tc）；kmod-sched-cake 由固件流提供，
#      kmod-ifb 由固件流以 =m 编出 apk；nftables 由 nftables-json 提供
CONFIG_PACKAGE_luci-app-sqm=m
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=m
CONFIG_PACKAGE_sqm-scripts=m
CONFIG_PACKAGE_tc-tiny=m
