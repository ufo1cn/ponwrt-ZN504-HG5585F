# ==============================================================================
# PonWrt ZN504 (Airoha AN7581) Enhanced Release Configuration
# Synthesizing:
# 1. QWRT Recommended: Hardware Crypto (EIP-93), Hardware PPE, 2.5G EN8811H PHY,
#    CPUFreq Scaling, RAMFree, Diskman, TTYD Web Terminal, FileTransfer
# 2. QWRT Optional: Samba4 (KSMBD), WOL Ultra, GecoosAC
# 3. Kahen Project Essence: SoC Thermal Telemetry (/sbin/tempinfo RPC),
#    kmod-mtd-rw, autocore, Footstrap Theme, Simplified Chinese LuCI
# 4. LeoooChen Project Essence: Line-rate PPPoE & XG-PON Flow Offloading,
#    TCP BBR + CAKE Qdisc, 8MB High-Throughput Buffers
# 5. Dual-Engine Transparent Proxy: Native Sing-Box Core & Honk eBPF Zero-Copy Gateway
# ==============================================================================

# ---------------------------------------------------------
# 1. LeoooChen Essence: Line-Rate Offload & Networking Stack
# ---------------------------------------------------------
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=m
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=m
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_bpftool=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_mount-utils=y

# ---------------------------------------------------------
# 1.1 Kernel eBPF CO-RE & BTF Type Information Support
# ---------------------------------------------------------
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y
CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_BPF_EVENTS=y

# ---------------------------------------------------------
# 2. Hardware Acceleration & Pure Crypto Pipeline
# ---------------------------------------------------------
# SafeXcel EIP-93 disabled following First Principles & upstream ImmortalWrt da63f7d
# (eliminates DMA mapping/IRQ overhead, prevents priority inversion, frees 4-core NEON for WireGuard & Sing-Box/Honk)
# CONFIG_PACKAGE_kmod-crypto-hw-eip93 is not set
# CONFIG_PACKAGE_kmod-cryptodev is not set
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-authenc=y
CONFIG_PACKAGE_kmod-crypto-des=y
CONFIG_PACKAGE_kmod-crypto-ecb=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-seqiv=y
CONFIG_PACKAGE_kmod-crypto-user=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-sha512=y
CONFIG_PACKAGE_kmod-crypto-chacha20poly1305=y

# Airoha AN7581 2.5G PHY (EN8811H) & NPU / PPE Hardware Flow Acceleration
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_PACKAGE_luci-app-hqos=y

# ---------------------------------------------------------
# 3. QWRT Recommended: System Tuning & Management Utilities
# ---------------------------------------------------------
# CPU Frequency Scaling & Thermal Control
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# Disk Management & Storage Partitioner
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y

# Web Terminal (TTYD)
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# Hardware Inspection & Diagnostics
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y

# ---------------------------------------------------------
# 4. Kahen Essence: Telemetry, Partitions & Interface
# ---------------------------------------------------------
# Read-Write MTD Support for Safe Partition Backup & Calibration Extraction
CONFIG_PACKAGE_kmod-mtd-rw=y

# Autocore System & SoC Telemetry
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_libudev-zero=y

# UI Themes & Simplified Chinese Localization & Asia/Shanghai Zoneinfo
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-footstrap=y
CONFIG_PACKAGE_zoneinfo-asia=y

# ---------------------------------------------------------
# 5. Dual-Engine Transparent Proxy (Sing-Box & Honk eBPF)
# ---------------------------------------------------------
# Native Sing-Box Core
CONFIG_PACKAGE_sing-box=y

# Honk eBPF Core & LuCI Web Interface
# honk 只编 apk、不无条件进所有机型镜像；装不装由 DEVICE_PREINSTALL 按机型决定
CONFIG_PACKAGE_honk=m
CONFIG_PACKAGE_luci-app-honk=m
CONFIG_PACKAGE_luci-lib-daeuniverse=y
CONFIG_PACKAGE_luci-i18n-daeuniverse-zh-cn=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# Momo completely removed
# CONFIG_PACKAGE_luci-app-momo is not set
# CONFIG_PACKAGE_momo is not set

# ---------------------------------------------------------
# 6. IPTV Multicast, Remote Access, DNS & Firewall
# ---------------------------------------------------------
# IPTV Multicast Proxy (rtp2httpd, replacing msd_lite / udpxy)
# CONFIG_PACKAGE_msd_lite is not set
# CONFIG_PACKAGE_luci-app-msd_lite is not set
# CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn is not set
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y

# Cloudflare DDNS
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# Full DNSMASQ (supporting ipset, nftset and DNSSEC)
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# NFQUEUE Transparent Redirection
CONFIG_PACKAGE_kmod-nfnetlink-queue=m
CONFIG_PACKAGE_kmod-nft-queue=m
CONFIG_PACKAGE_kmod-ipt-nfqueue=y

# ---------------------------------------------------------
# 7. Wireless & Wi-Fi Stack (HG5585F MT7916 DBDC & WED Offload)
# ---------------------------------------------------------
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7916-firmware=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y


# YAML CLI processor for Nikki & scripts
CONFIG_PACKAGE_yq=y

# Vantage Modern Dependencies
CONFIG_PACKAGE_ucode-mod-nl80211=y
CONFIG_PACKAGE_ucode-mod-rtnl=y
# PonWrt firmware update (GUI: check/download/flash, reads apk-repo meta/fw index)
CONFIG_PACKAGE_luci-app-ponwrt-update=y
