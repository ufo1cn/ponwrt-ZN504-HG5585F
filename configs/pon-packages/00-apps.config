# pon-packages/00-apps.config —— 自有上层应用（纯用户态，无内核碎片）
#
# 由 build-firmware-manual.yml / build-packages-incremental.yml 统一合并进 .config。
# 源码在 package/pon-userspace/<pkg>/。

CONFIG_PACKAGE_camlive=y
CONFIG_PACKAGE_luci-app-camlive=y
CONFIG_PACKAGE_go2rtc=y
CONFIG_PACKAGE_luci-app-go2rtc=y
CONFIG_PACKAGE_gensio=y
CONFIG_PACKAGE_gensio-bin=y
CONFIG_PACKAGE_ser2net=y
CONFIG_PACKAGE_luci-app-ser2net=y
