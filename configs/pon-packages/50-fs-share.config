# pon-packages/50-fs-share.config —— 文件系统 / 磁盘挂载 / NFS
#
# 方案 A：内核只内置基础设施，功能驱动保持模块化。
# NFS 全链（client + server）**不再内置**，由本文件选中 kmod 包，
# 用 build-packages-incremental.yml 的同一内核树编成 apk 后按需安装；
# 这样后期升级 NFS / 加挂载能力不必重刷固件。

CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_nfs-kernel-server=y
CONFIG_PACKAGE_nfs-kernel-server-utils=y
CONFIG_PACKAGE_nfs-utils=y
CONFIG_PACKAGE_nfs-utils-libs=y
