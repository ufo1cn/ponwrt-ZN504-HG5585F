# pon-packages/70-iptv.config —— IPTV 组播转单播（纯用户态，无内核碎片）
#
# 由 build-packages-incremental.yml 合并进 .config；该流程不产镜像，
# 这里的 =y 只是让 make 认账把包编出来，产物是独立 apk，不会烘进任何固件。
#
# msd_lite：多路并发转单播，单进程 epoll + 多线程，比 udpxy 省资源；
#           不依赖任何 kmod，也不需要与内核同批编译。
# luci-app-msd_lite：LuCI「服务 > MSD Lite」配置页（source / 端口 / 上游接口）。
# luci-i18n-msd_lite-zh-cn：中文翻译，随 app 同目录编出。

CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y
