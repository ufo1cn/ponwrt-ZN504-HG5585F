# pon-packages/30-bluetooth.config —— 蓝牙音频（A2DP/HFP）+ 蓝牙串口
#
# bluez-alsa 是本仓库自建包（package/pon-userspace/bluez-alsa，源码取自上游
# arkq/bluez-alsa v4.3.1），不再依赖第三方包仓库 bluealsa4openwrt。

# 内核侧
CONFIG_PACKAGE_kmod-bluetooth=y
CONFIG_PACKAGE_kmod-btusb=y
CONFIG_PACKAGE_kmod-btbcm=y
CONFIG_PACKAGE_kmod-btmtk=y
CONFIG_PACKAGE_kmod-hci-uart=y
# bluez input 插件建 HID 设备需要 uhid（经典 HID 与 BLE HOG 共用）
CONFIG_PACKAGE_kmod-uhid=y

# 蓝牙协议栈（标准 feeds）
CONFIG_PACKAGE_bluez-daemon=y
CONFIG_PACKAGE_bluez-libs=y
CONFIG_PACKAGE_bluez-utils=y
CONFIG_PACKAGE_bluez-utils-extra=y
CONFIG_PACKAGE_libical=y
CONFIG_PACKAGE_libdbus=y
CONFIG_PACKAGE_dbus=y
CONFIG_PACKAGE_glib2=y
CONFIG_PACKAGE_sbc=y

# 本仓库自有：BlueALSA 后端 + 蓝牙音频前端 + 蓝牙串口前端
CONFIG_PACKAGE_bluez-alsa=y
CONFIG_PACKAGE_luci-app-blueaudio=y
CONFIG_PACKAGE_luci-app-btsp=y
# 蓝牙键鼠/遥控的按键映射服务（自建包，thd + /etc/config/bt-keys 动作表）
CONFIG_PACKAGE_triggerhappy=y
