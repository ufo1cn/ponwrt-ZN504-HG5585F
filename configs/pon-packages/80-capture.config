# pon-packages/80-capture.config —— 抓包 / 流量分析（纯用户态）
#
# 由 build-packages-incremental.yml 合并进 .config；该流程不产镜像，
# 产物是独立 apk，装不装由设备决定。
#
# 说明：
#   · tcpdump 已 =y 烘进固件镜像（an7581.config），这里不再编，
#     否则同名包会和镜像内文件撞车。
#   · 下列库是 iftop / iptraf-ng / sngrep 会被链接的依赖，必须先编出同 ABI 的 apk：
#       libncurses / libncursesw / terminfo / libpcap
#   · zlib / libopenssl / libpcre2 镜像里已 =y，无需重复。
#   · 包来源：iftop / iptraf-ng / darkstat / nlbwmon 在 immortalwrt/packages，
#             sngrep 在 openwrt/telephony（feeds 名 telephony）。

CONFIG_PACKAGE_libncurses=y
CONFIG_PACKAGE_libncursesw=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_libpcap=y

# 抓包 / 流量查看
CONFIG_PACKAGE_sngrep=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_iptraf-ng=y
CONFIG_PACKAGE_darkstat=y

# 带宽统计 + 三方界面 / 翻译
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
