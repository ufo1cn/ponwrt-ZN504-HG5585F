# 软件仓库专用 kmod 片段（由固件构建流程应用，=m：只编 apk，不进镜像）
# ------------------------------------------------------------------------------
# 背景：kmod 一律由固件构建流程（fw-build.yml）在**与固件同一次构建、同一棵树**上
#       编出来，再作为 apk 发布；三条包工作流（incremental / legacy / extra）只编用户态。
#       这样 kmod 的 vermagic 永远与固件一致，不会出现 `kernel (= …~vermagic-rN)` 装不上。
#
# 这里只放"固件能力片段没覆盖、但用户态包要用"的 kmod：
#   · NFS 全链（samba/nfs 共享用）——没进 release.config，也没进 usb.config
#   · 内核诊断（ss/netstat 的 inet_diag / netlink_diag）
# USB / 摄像头 / 音频 / 蓝牙 / rtw88 那些已经写在 configs/features/usb.config 里
# （bake_usb=true 时被改写成 =y 烘进镜像，同时仍会产出 apk），无需在此重复。
#
# 必须写 =m：写 =y 会把模块烘进镜像，之后设备再装同名 apk 会撞文件。
# ------------------------------------------------------------------------------

CONFIG_PACKAGE_kmod-fs-nfs=m
CONFIG_PACKAGE_kmod-fs-nfs-common=m
CONFIG_PACKAGE_kmod-fs-nfs-v4=m
# btrfs：模块较大（镜像体积考虑），只编 apk 供按需安装，不烘进固件；
# 装好后靠 busybox blkid 的 BTRFS 探测参与热插拔自动挂载。
# 内核层符号必须一起写成 m：an7581.config 里是 "# CONFIG_KERNEL_BTRFS_FS is not set"
# （厂商原始配置显式关掉），显式 not set 优先级高于包选择给出的默认值，
# 只写 CONFIG_PACKAGE_kmod-fs-btrfs=m 会被 kconfig 直接清回 not set（run 45361837949 实测）。
CONFIG_KERNEL_BTRFS_FS=m
CONFIG_PACKAGE_kmod-fs-btrfs=m
CONFIG_PACKAGE_kmod-dnsresolver=m
CONFIG_PACKAGE_kmod-fs-nfsd=m
CONFIG_PACKAGE_kmod-fs-exportfs=m
CONFIG_PACKAGE_kmod-fs-nfs-common-rpcsec=m
CONFIG_PACKAGE_kmod-inet-diag=m
CONFIG_PACKAGE_kmod-netlink-diag=m

# 树外 feed 的 kmod（与 luci-app-iptv / omcproxy 配套的组播数据面）：
#   源码 src-git iptv https://github.com/yveming/openwrt-iptv.git
#   fw-build 在 feeds update 之前会把这个 feed 追加进 feeds.conf.default，
#   因此这里可以按 KernelPackage 编，vermagic 与固件一致。
CONFIG_PACKAGE_kmod-iptv=m
# iptv 上层（用户态）与 kmod 成对，同一个 feed、同一次构建编出来，
# 版本永远锁在一起；=m 只出 apk，不烘进镜像。
CONFIG_PACKAGE_luci-app-iptv=m
CONFIG_PACKAGE_luci-i18n-iptv-zh-cn=m
CONFIG_PACKAGE_kmod-crypto-aead=m
CONFIG_PACKAGE_kmod-crypto-authenc=m
CONFIG_PACKAGE_kmod-crypto-cbc=m
CONFIG_PACKAGE_kmod-crypto-cmac=m
CONFIG_PACKAGE_kmod-crypto-cts=m
CONFIG_PACKAGE_kmod-crypto-hash=m
CONFIG_PACKAGE_kmod-crypto-hmac=m
CONFIG_PACKAGE_kmod-crypto-krb5=m
CONFIG_PACKAGE_kmod-crypto-manager=m
CONFIG_PACKAGE_kmod-crypto-null=m
CONFIG_PACKAGE_kmod-crypto-sha1=m
CONFIG_PACKAGE_kmod-crypto-sha256=m
CONFIG_PACKAGE_kmod-crypto-sha512=m
CONFIG_PACKAGE_kmod-oid-registry=m


# ------------------------------------------------------------------------------
# 存储 / 文件系统（=m：只出 apk，装到 USB 盘上按需使用）
#   fuse：ntfs-3g / rclone mount / sshfs 的底座（内核 ntfs3 之外的第二条路）
#   loop / nbd：挂 ISO/img 文件、网络块设备
#   md：软 RAID（配合 md-raid0/1/456），USB 多盘冗余
#   xfs / udf / hfsplus：大容量盘、ISO 影碟、Mac 格式盘
# 注意：kmod-dm（LVM2 / dm-crypt / LUKS）的 KCONFIG 强制 CONFIG_BLK_DEV_MD=n，
#       与 kmod-md 的 CONFIG_BLK_DEV_MD=m 互斥，两者不能同时开；
#       本轮选 md（NAS 多盘），以后要做 LUKS 需要单开一条 profile。
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-fuse=m
CONFIG_PACKAGE_kmod-loop=m
CONFIG_PACKAGE_kmod-nbd=m
CONFIG_PACKAGE_kmod-md=m
CONFIG_PACKAGE_kmod-md-raid0=m
CONFIG_PACKAGE_kmod-md-raid1=m
CONFIG_PACKAGE_kmod-md-raid456=m
CONFIG_PACKAGE_kmod-fs-xfs=m
CONFIG_PACKAGE_kmod-fs-udf=m
CONFIG_PACKAGE_kmod-fs-hfsplus=m

# ------------------------------------------------------------------------------
# 防火墙 / NAT 兼容（老插件与 iptables 规则要用，=m 不占镜像）
#   ipt-ipset：passwall/shadowsocks 老版本、防蹭网类脚本
#   ipt-nat：MASQUERADE 等 iptables NAT 目标（nft 侧已内建，这里补 iptables 侧）
#   nf-nathelper-extra：FTP/SIP/H323/PPTP/IRC/TFTP 等 ALG，缺了被动 FTP 与 VoIP 常不通
#   br-netfilter：透明桥 / 旁路由模式下的桥接 netfilter
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-ipt-ipset=m
CONFIG_PACKAGE_kmod-ipt-nat=m
CONFIG_PACKAGE_kmod-nf-nathelper-extra=m
CONFIG_PACKAGE_kmod-br-netfilter=m

# ------------------------------------------------------------------------------
# QoS：cake 已内建，ifb 补上后才能做 SQM 入口（下载方向）整形
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-ifb=m

# ---------------------------------------------------------------- 代理 / VPN 相关可选 kmod（=m：只编 apk 发仓库，不进镜像）
# 口径：常用项保留 =y 烘进固件（见 configs/release.config），其余全部 =m，
# 设备端需要哪个功能就 apk add 哪个模块。
CONFIG_PACKAGE_kmod-nft-socket=m
CONFIG_PACKAGE_kmod-nft-bridge=m
CONFIG_PACKAGE_kmod-nft-fib=m
CONFIG_PACKAGE_kmod-nft-fullcone=m
CONFIG_PACKAGE_kmod-nft-queue=m
CONFIG_PACKAGE_kmod-nft-compat=m
CONFIG_PACKAGE_kmod-nft-netdev=m
CONFIG_PACKAGE_kmod-nf-socket=m
CONFIG_PACKAGE_kmod-nf-tproxy=m
CONFIG_PACKAGE_kmod-nfnetlink-queue=m
CONFIG_PACKAGE_kmod-macvlan=m
CONFIG_PACKAGE_kmod-ipt-core=m
CONFIG_PACKAGE_kmod-ipt-nfqueue=m
CONFIG_PACKAGE_kmod-ipt-tproxy=m
CONFIG_PACKAGE_kmod-ipt-nat6=m
CONFIG_PACKAGE_kmod-nf-nat6=m
CONFIG_PACKAGE_kmod-ipsec=m
CONFIG_PACKAGE_kmod-crypto-xcbc=m
CONFIG_PACKAGE_kmod-crypto-echainiv=m

# ksmbd（内核态 SMB 服务端，CONFIG_SMB_SERVER）：默认 =m 只出 apk、不进镜像，
# 与 samba4（用户态 smbd）不冲突，可长期共存；只有同时启动两个 SMB 服务才会抢 445。
CONFIG_PACKAGE_kmod-fs-ksmbd=m

# OAF / OpenAppFilter：kmod-oaf 是树外内核模块（KernelPackage/oaf），KCONFIG 由该
# Makefile 自身注入，必须由固件流程与固件内核同一次编译；=m 只发 apk、不进镜像。
# 依赖 kmod-nf-conntrack 与 kmod-nf-reject：an7581.config 已把两者 =y 内建进镜像，
# 这里不要再写 =m —— fw-build 对“已是 =y”的符号整条跳过，写了也只会让人误会要单出 apk。
CONFIG_PACKAGE_kmod-oaf=m

# appfilter（OpenAppFilter 规则引擎）：Makefile 与 oaf.ko 同目录、用 $(KERNEL_MAKE) 一起编，
# 包流 preflight 判为“需要内核源码树”而拒绝，因此只能随固件流编（=m 只发 apk）。
CONFIG_PACKAGE_appfilter=m