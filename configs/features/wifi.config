# 能力片段：wifi —— 机型带内置（PCIe）无线时应用本片段
# ------------------------------------------------------------------------------
# 当前只有 HG5585F-CT / HG5585F-CU 这类 MT7916 DBDC 机型命中；它们的内置无线必须
# 进镜像，所以这里写 =y（与 configs/release.config 的取值一致，写在这里是为了让
# 「能力 -> 配置」的关系可有据可查，将来换机型不用改工作流）。
# ------------------------------------------------------------------------------

CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7916-firmware=y
