# 能力片段：usb —— 机型带 USB 主机口时应用本片段
# ------------------------------------------------------------------------------
# 用法由 build-firmware-manual.yml 统一处理：片段每行要么 `CONFIG_X=y|m`，要么
# `# CONFIG_X is not set`；工作流会删掉同名符号的旧行，再按本文件写回 .config
# （写完不再 defconfig，否则机型行会被重算掉）。
#
# 口径：
#   * 镜像里必须有的核心栈（kmod-usb3 / xhci-hcd / xhci-mtk / storage / uas）由机型
#     profile 的 DEVICE_PACKAGES 带进镜像，这里不重复写死 =y；
#   * 其余全部 =m：编出来的 apk 进自建仓库的 usb 能力目录，设备上 apk add 按需装，
#     镜像体积不被几十个模块撑大；
#   * USB 总线上的无线网卡驱动也在这里（插 USB 网卡用），所以「有 USB 无内置无线」
#     的机型（如 Nokia XG-040G-MD）只挂本片段也能用 USB 网卡。
# ------------------------------------------------------------------------------

# USB 主机控制 + USBIP / USB 设备监控
CONFIG_PACKAGE_kmod-usb2=m
CONFIG_PACKAGE_kmod-usb-common=m
CONFIG_PACKAGE_kmod-usbmon=m
CONFIG_PACKAGE_kmod-usbip=m
CONFIG_PACKAGE_kmod-usbip-client=m
CONFIG_PACKAGE_kmod-usbip-server=m
CONFIG_PACKAGE_usbip=m
CONFIG_PACKAGE_usbutils=m

# USB 网卡（含 2.5G/千兆网卡、手机共享网络、蜂窝模块）
CONFIG_PACKAGE_kmod-usb-net=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=m
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=m
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=m
CONFIG_PACKAGE_kmod-usb-net-rndis=m
CONFIG_PACKAGE_kmod-usb-net-ipheth=m
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=m
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-quectel=m
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-fibocom=m
CONFIG_PACKAGE_kmod-usb-net-rtl8152=m
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=m
CONFIG_PACKAGE_kmod-usb-net-asix=m
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=m
CONFIG_PACKAGE_kmod-usb-net-aqc111=m
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=m
CONFIG_PACKAGE_kmod-usb-net-lan78xx=m
CONFIG_PACKAGE_kmod-usb-net-sr9700=m
CONFIG_PACKAGE_kmod-usb-net-hso=m

# USB 串口（调试线、4G/5G 模块 AT 口）
CONFIG_PACKAGE_kmod-usb-serial=m
CONFIG_PACKAGE_kmod-usb-serial-ch341=m
CONFIG_PACKAGE_kmod-usb-serial-cp210x=m
CONFIG_PACKAGE_kmod-usb-serial-ftdi=m
CONFIG_PACKAGE_kmod-usb-serial-pl2303=m
CONFIG_PACKAGE_kmod-usb-serial-option=m
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=m
CONFIG_PACKAGE_kmod-usb-serial-mos7720=m
CONFIG_PACKAGE_kmod-usb-serial-mos7840=m
CONFIG_PACKAGE_kmod-usb-serial-simple=m

# USB 存储扩展 / HID / 声卡类 / 打印 / WDM
CONFIG_PACKAGE_kmod-usb-storage-extras=m
CONFIG_PACKAGE_kmod-usb-hid=m
CONFIG_PACKAGE_kmod-usb-acm=m
CONFIG_PACKAGE_kmod-usb-printer=m
CONFIG_PACKAGE_kmod-usb-wdm=m

# USB 无线网卡（插在 USB 口上的 WiFi 模块；PCIe 内置无线见 wifi 片段）
CONFIG_PACKAGE_kmod-ath9k-htc=m
CONFIG_PACKAGE_kmod-carl9170=m
CONFIG_PACKAGE_kmod-mt7601u=m
CONFIG_PACKAGE_kmod-mt76x0u=m
CONFIG_PACKAGE_kmod-mt76x2u=m
CONFIG_PACKAGE_kmod-mt7663u=m
CONFIG_PACKAGE_kmod-mt7921u=m
CONFIG_PACKAGE_kmod-rtl8xxxu=m
CONFIG_PACKAGE_kmod-rtl8188eu=m
CONFIG_PACKAGE_kmod-rtl8192cu=m
CONFIG_PACKAGE_kmod-rtl8192du=m
CONFIG_PACKAGE_kmod-rtw88-8723du=m
CONFIG_PACKAGE_kmod-rtw88-8812au=m
CONFIG_PACKAGE_kmod-rtw88-8814au=m
CONFIG_PACKAGE_kmod-rtw88-8821au=m
CONFIG_PACKAGE_kmod-rtw88-8821cu=m
CONFIG_PACKAGE_kmod-rtw88-8822bu=m
CONFIG_PACKAGE_kmod-rtw88-8822cu=m
