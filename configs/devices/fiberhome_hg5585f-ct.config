# 机型定义 —— 唯一事实来源：能力 + 预装进本机型 rootfs 的包清单
# HG5585F 电信版：USB + 内置 MT7916 无线 + 蓝牙
#
# CAPS：机型能力（usb / wifi / bt；空=只有公共部件）。能力只决定“装什么进镜像”，
#       不决定“编什么”——所有 kmod 都由固件流程统一编出（=m），三机型内核指纹一致。
# PREINSTALL：这个机型要预装进 rootfs 的包（旧 bake_usb=true 的效果）。
#       没列在这里的 kmod 只出 apk、不进镜像（设备上按需 apk add）。

DEVICE_BOARD=fiberhome_hg5585f-ct
DEVICE_CAPS=usb wifi bt
DEVICE_PREINSTALL=kmod-usb2 kmod-usb-common kmod-usbmon kmod-usbip kmod-usbip-client kmod-usbip-server usbip usbutils kmod-usb-net kmod-usb-net-cdc-ether kmod-usb-net-cdc-ncm kmod-usb-net-cdc-mbim kmod-usb-net-cdc-eem kmod-usb-net-cdc-subset kmod-usb-net-rndis kmod-usb-net-ipheth kmod-usb-net-huawei-cdc-ncm kmod-usb-net-qmi-wwan kmod-usb-net-qmi-wwan-quectel kmod-usb-net-qmi-wwan-fibocom kmod-usb-net-rtl8152-vendor kmod-usb-net-asix kmod-usb-net-asix-ax88179 kmod-usb-net-aqc111 kmod-usb-net-smsc95xx kmod-usb-net-lan78xx kmod-usb-net-sr9700 kmod-usb-net-hso kmod-usb-serial kmod-usb-serial-ch341 kmod-usb-serial-cp210x kmod-usb-serial-ftdi kmod-usb-serial-pl2303 kmod-usb-serial-option kmod-usb-serial-qualcomm kmod-usb-serial-mos7720 kmod-usb-serial-mos7840 kmod-usb-serial-simple kmod-usb-storage-extras kmod-usb-hid kmod-usb-acm kmod-usb-printer kmod-usb-wdm kmod-ath9k-htc kmod-carl9170 kmod-mt7601u kmod-mt76x0u kmod-mt76x2u kmod-mt7663u kmod-mt7921u kmod-rtl8xxxu kmod-rtl8188eu kmod-rtl8192cu kmod-rtl8192du kmod-rtw88-8723du kmod-rtw88-8812au kmod-rtw88-8814au kmod-rtw88-8821au kmod-rtw88-8821cu kmod-rtw88-8822bu kmod-rtw88-8822cu kmod-scsi-core kmod-usb-storage kmod-usb-storage-uas kmod-usb-storage-extras kmod-fs-ext4 kmod-fs-vfat kmod-fs-exfat kmod-fs-ntfs3 kmod-fs-f2fs kmod-fs-cifs kmod-fs-smbfs-common kmod-crypto-md5 kmod-asn1-decoder kmod-sound-core kmod-usb-audio audio-support kmod-dma-buf kmod-lib-rational kmod-video-core kmod-video-videobuf2 kmod-video-vmalloc kmod-video-uvc video-support kmod-bluetooth kmod-crypto-ecdh kmod-btusb kmod-btbcm kmod-btmtk kmod-hci-uart kmod-uhid kmod-hid kmod-hid-generic kmod-input-core kmod-media-controller printer-support kmod-usb-serial-ch348 kmod-usb-serial-wwan usb-modeswitch usbids r8152-firmware rtl8192cu-firmware rtl8723bu-firmware rtl8723de-firmware rtl8821ce-firmware rtl8822ce-firmware kmod-usb-core kmod-usb3 kmod-usb-xhci-hcd kmod-usb-xhci-mtk input-support kmod-rtl8192c-common kmod-rtlwifi-usb kmod-rtw88 kmod-rtw88-8723d kmod-rtw88-8723x kmod-rtw88-8821c kmod-rtw88-8822c kmod-rtw88-usb kmod-crypto-aead kmod-crypto-ccm kmod-crypto-cmac kmod-crypto-crc32c kmod-crypto-ctr kmod-crypto-des kmod-crypto-ecb kmod-crypto-geniv kmod-crypto-hash kmod-crypto-hmac kmod-crypto-kpp kmod-crypto-manager kmod-crypto-rng kmod-crypto-seqiv kmod-crypto-sha256 kmod-crypto-sha3 kmod-crypto-sha512 kmod-dnsresolver kmod-fixed-phy kmod-fs-netfs kmod-lib-crc16 kmod-libphy kmod-mdio-devres kmod-mii kmod-net-selftests kmod-nls-base kmod-nls-cp437 kmod-nls-iso8859-1 kmod-nls-ucs2-utils kmod-nls-utf8 kmod-oid-registry kmod-phy-ax88796b kmod-phy-microchip kmod-phy-smsc kmod-phylink kmod-ppdev kmod-regmap-core kmod-rfkill kmod-usb-ehci block-mount kmod-mt7915e kmod-mt7916-firmware kmod-zram zram-swap cifsmount alsa-utils
