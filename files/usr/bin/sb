#!/bin/sh
# ==============================================================================
# sb-honk: Sing-Box (裸核) & Honk (eBPF) 统一内核管理与互斥切换快捷指令
# 特点：纯裸核原生 procd 服务管理、无 momo 依赖、自动处理 Flow Offload、实时日志
# ==============================================================================

# 自动自举与快捷软链
self_path=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
if [ "$self_path" != "/usr/bin/sb-honk" ] && [ -d "/usr/bin" ]; then
    cp -f "$self_path" /usr/bin/sb-honk 2>/dev/null && chmod +x /usr/bin/sb-honk 2>/dev/null
    ln -sf /usr/bin/sb-honk /usr/bin/sb-bonk 2>/dev/null
    ln -sf /usr/bin/sb-honk /usr/bin/sb 2>/dev/null
fi

# 颜色控制（注入真实 ESC 控制字节，确保在 Mac 终端与各类 SSH 终端完美渲染）
ESC=$(printf '\033')
RED="${ESC}[0;31m"
GREEN="${ESC}[0;32m"
YELLOW="${ESC}[1;33m"
BLUE="${ESC}[0;34m"
PURPLE="${ESC}[0;35m"
CYAN="${ESC}[0;36m"
BOLD="${ESC}[1m"
NC="${ESC}[0m"

# 核心状态检测函数
get_status() {
    # 检测 sing-box (纯裸核)
    sb_pid=$(pgrep -f "sing-box run" 2>/dev/null | head -n 1)
    if [ -n "$sb_pid" ]; then
        SB_STATE="${GREEN}● 运行中 (PID: $sb_pid)${NC}"
        SB_ACTIVE=1
    else
        SB_STATE="${RED}○ 已停止${NC}"
        SB_ACTIVE=0
    fi

    # 检测 honk
    honk_pid=$(pgrep honk-core 2>/dev/null | head -n 1)
    [ -z "$honk_pid" ] && honk_pid=$(pgrep -f "/usr/bin/honk" 2>/dev/null | head -n 1)
    if [ -n "$honk_pid" ]; then
        HONK_STATE="${GREEN}● 运行中 (PID: $honk_pid)${NC}"
        HONK_ACTIVE=1
    else
        HONK_STATE="${RED}○ 已停止${NC}"
        HONK_ACTIVE=0
    fi

    # 检测防火墙流分流
    flow_offload=$(uci get firewall.@defaults[0].flow_offloading 2>/dev/null || echo "0")
    if [ "$flow_offload" = "1" ]; then
        FLOW_STATE="${YELLOW}开启 (Flow Offload ON)${NC}"
    else
        FLOW_STATE="${GREEN}关闭 (Flow Offload OFF，适配 eBPF)${NC}"
    fi

    # 检测 DNS 劫持与防泄露模式
    dns_server=$(uci -q get dhcp.@dnsmasq[0].server || echo "")
    dns_noresolv=$(uci -q get dhcp.@dnsmasq[0].noresolv || echo "0")
    if [ "$dns_noresolv" = "1" ] && echo "$dns_server" | grep -q "5353"; then
        DNS_STATE="${GREEN}Honk DoH (127.0.0.1#5353 零泄露模式)${NC}"
    else
        DNS_STATE="${YELLOW}系统默认 (WAN 上游 / Sing-Box TUN 接管)${NC}"
    fi
}

# 进程平滑退出与超时硬杀 (最多等待 timeout 秒，避免残存孤儿进程)
graceful_stop_proc() {
    local pattern="$1"
    local kill_name="$2"
    local timeout="${3:-5}"
    local count=0
    while [ "$count" -lt "$timeout" ]; do
        if ! pgrep -f "$pattern" >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
        count=$((count + 1))
    done
    killall -9 "$kill_name" 2>/dev/null || true
}

# 彻底清理 Sing-Box 残留的 nftables 规则、TUN 虚拟网卡与策略路由表 (避免切换 Honk 后国内流量被黑洞重定向)
cleanup_singbox_leftovers() {
    nft delete table inet sing-box 2>/dev/null || true
    ip link del tun0 2>/dev/null || true
    for fam in -4 -6; do
        for pref in $(ip $fam rule show 2>/dev/null | awk -F: '/lookup 2022|0x2023|0x2024/ {gsub(/^[ \t]+|[ \t]+$/, "", $1); print $1}'); do
            ip $fam rule del pref "$pref" 2>/dev/null || true
        done
        ip $fam rule del pref 9002 2>/dev/null || true
        ip $fam route flush table 2022 2>/dev/null || true
    done
}

# 清理 Honk 残留的 nftables 规则与网卡
cleanup_honk_leftovers() {
    nft delete table inet honk_nfqueue 2>/dev/null || true
    ip link del dae0 2>/dev/null || true
}

# 多核 RPS/RFS 软中断分流调优 (针对 Airoha AN7581 多队列，突破单核纯软转发吞吐上限)
apply_rps_tuning() {
    local mask="${1:-d}"
    sysctl -w net.core.rps_sock_flow_entries=32768 >/dev/null 2>&1
    for dev in pon0 eth0 lan1 lan2 lan3 lan4 pppoe-wan br-lan phy0-ap0 phy1-ap0 dae0; do
        if [ -d "/sys/class/net/$dev/queues" ]; then
            for q in /sys/class/net/$dev/queues/rx-*; do
                [ -f "$q/rps_cpus" ] && echo "$mask" > "$q/rps_cpus" 2>/dev/null
                [ -f "$q/rps_flow_cnt" ] && echo 4096 > "$q/rps_flow_cnt" 2>/dev/null
            done
        fi
    done
    if [ -f /sys/devices/system/cpu/cpufreq/ondemand/powersave_bias ]; then
        echo 0 > /sys/devices/system/cpu/cpufreq/ondemand/powersave_bias 2>/dev/null
    fi
    if [ -w /sys/kernel/debug/ppe/bind_rate ]; then
        echo "5 5" > /sys/kernel/debug/ppe/bind_rate 2>/dev/null
    fi
}

# 1. 切换到 Honk (停止 Sing-Box 裸核，调整防火墙与 DNS，启动 Honk)
switch_to_honk() {
    echo ""
    echo "${CYAN}${BOLD}[1/5] 检查并停止 Sing-Box (裸核)...${NC}"
    /etc/init.d/sing-box stop 2>/dev/null
    graceful_stop_proc "sing-box run" "sing-box" 5
    cleanup_singbox_leftovers
    echo "  ${GREEN}✓ Sing-Box 已停止并清理残留规则${NC}"

    echo "${CYAN}${BOLD}[2/5] 调整防火墙 (启用硬件 PPE 芯片加速与流分流)...${NC}"
    uci set firewall.@defaults[0].flow_offloading='1' 2>/dev/null
    uci set firewall.@defaults[0].flow_offloading_hw='1' 2>/dev/null
    uci commit firewall 2>/dev/null
    /etc/init.d/firewall reload 2>/dev/null || /etc/init.d/firewall restart 2>/dev/null
    apply_rps_tuning "d"
    echo "  ${GREEN}✓ 硬件 PPE 芯片流分流加速已启用，全队列多核优化生效 (500M+ 满速且极低 CPU)${NC}"

    echo "${CYAN}${BOLD}[3/5] 联动 Dnsmasq (重定向至 Honk 127.0.0.1#5353 根除 DNS 泄露与抢答投毒)...${NC}"
    uci set dhcp.@dnsmasq[0].noresolv='1' 2>/dev/null
    uci -q delete dhcp.@dnsmasq[0].server 2>/dev/null
    uci add_list dhcp.@dnsmasq[0].server='127.0.0.1#5353' 2>/dev/null
    uci commit dhcp 2>/dev/null
    /etc/init.d/dnsmasq restart 2>/dev/null
    echo "  ${GREEN}✓ Dnsmasq 上游已锁定为 127.0.0.1#5353 (零泄露保护生效)${NC}"

    echo "${CYAN}${BOLD}[4/5] 检查 eBPF 虚拟文件系统 (bpffs)...${NC}"
    if ! mount | grep -q "/sys/fs/bpf"; then
        mkdir -p /sys/fs/bpf
        mount -t bpf bpffs /sys/fs/bpf 2>/dev/null
    fi
    echo "  ${GREEN}✓ bpffs 挂载就绪${NC}"

    echo "${CYAN}${BOLD}[5/5] 启动 Honk (eBPF 内核与数据库模式)...${NC}"
    if ! which honk-core >/dev/null 2>&1 && ! which honk >/dev/null 2>&1; then
        echo "  ${RED}✗ 未检测到 honk 二进制！请先选择菜单选项 10 安装 Honk。${NC}"
        return 1
    fi

    # 检查是否有更新后的 config.dae，若比 honk.db 新则归档旧 db，使 Honk 自动导入最新配置为 Revision 1
    if [ -f "/etc/honk/config.dae" ]; then
        mkdir -p /etc/honk/data/state
        if [ ! -f "/etc/honk/data/state/honk.db" ] || [ "/etc/honk/config.dae" -nt "/etc/honk/data/state/honk.db" ]; then
            if pgrep honk-core >/dev/null 2>&1; then
                if [ -x "/etc/init.d/honk" ]; then
                    /etc/init.d/honk stop 2>/dev/null
                fi
                graceful_stop_proc "honk-core|honk" "honk-core" 5
                killall -9 honk-core 2>/dev/null || true
                killall -9 honk 2>/dev/null || true
                sleep 1
            fi
            echo "  ${CYAN}↻ 检测到最新 config.dae，归档旧状态库以生成全新 Revision 1...${NC}"
            mv -f /etc/honk/data/state/honk.db /etc/honk/data/state/honk.db.bak 2>/dev/null || true
            rm -f /etc/honk/data/state/honk.db-shm /etc/honk/data/state/honk.db-wal 2>/dev/null || true
        fi
    fi

    uci set honk.config.store='db' 2>/dev/null
    uci commit honk 2>/dev/null

    if [ -x "/etc/init.d/honk" ]; then
        /etc/init.d/honk restart 2>/dev/null
    else
        ( trap "" HUP; honk-core --config /etc/honk/config.dae --store db --data-dir /etc/honk/data --log-file /var/log/honk.log >/dev/null 2>&1 ) </dev/null &
    fi

    sleep 1
    honk_pid=$(pgrep -f "honk" 2>/dev/null | head -n 1)
    if [ -n "$honk_pid" ]; then
        echo ""
        echo "${GREEN}${BOLD}🎉 成功切换至 Honk 内核！${NC}"
        echo "  • 核心状态: 运行中 (PID: $honk_pid)"
        echo "  • doona Web 仪表盘: ${CYAN}http://192.168.1.1:9092/ui/${NC}"
        echo "  • 配置文件: /etc/honk/config.dae"
        echo "  • DNS 解析: 127.0.0.1:5353 (DoH 零泄露)"
    else
        echo "  ${RED}✗ Honk 启动失败，请检查日志排查：sb-honk log honk${NC}"
    fi
}

# 2. 切换到 Sing-Box (停止 Honk，恢复 DNS 与防火墙，启动 Sing-Box 裸核)
switch_to_singbox() {
    echo ""
    echo "${CYAN}${BOLD}[1/4] 检查并停止 Honk...${NC}"
    if [ -x "/etc/init.d/honk" ]; then
        /etc/init.d/honk stop 2>/dev/null
    fi
    graceful_stop_proc "honk-core|honk" "honk-core" 5
    killall -9 honk-core 2>/dev/null || true
    killall -9 honk 2>/dev/null || true
    cleanup_honk_leftovers
    echo "  ${GREEN}✓ Honk 已停止并清理残留规则${NC}"

    echo "${CYAN}${BOLD}[2/4] 恢复 Dnsmasq 默认解析配置...${NC}"
    uci set dhcp.@dnsmasq[0].noresolv='0' 2>/dev/null
    uci -q delete dhcp.@dnsmasq[0].server 2>/dev/null
    uci commit dhcp 2>/dev/null
    /etc/init.d/dnsmasq restart 2>/dev/null
    echo "  ${GREEN}✓ Dnsmasq 解析已恢复系统默认 (WAN 上游 / Sing-Box TUN 接管)${NC}"

    echo "${CYAN}${BOLD}[3/4] 恢复防火墙流分流 (开启 Flow Offloading 与硬件 PPE 芯片加速)...${NC}"
    uci set firewall.@defaults[0].flow_offloading='1' 2>/dev/null
    uci set firewall.@defaults[0].flow_offloading_hw='1' 2>/dev/null
    uci commit firewall 2>/dev/null
    /etc/init.d/firewall reload 2>/dev/null || /etc/init.d/firewall restart 2>/dev/null
    echo "  ${GREEN}✓ 防火墙流分流与硬件 PPE 芯片加速已恢复开启${NC}"

    echo "${CYAN}${BOLD}[4/4] 启动 Sing-Box (裸核)...${NC}"
    /etc/init.d/sing-box restart 2>/dev/null || /etc/init.d/sing-box start 2>/dev/null

    sleep 1
    sb_pid=$(pgrep -f "sing-box run" 2>/dev/null | head -n 1)
    if [ -n "$sb_pid" ]; then
        echo ""
        echo "${GREEN}${BOLD}🎉 成功切换至 Sing-Box (裸核)！${NC}"
        echo "  • 核心状态: 运行中 (PID: $sb_pid)"
        echo "  • Clash API 控制面板: ${CYAN}http://192.168.1.1:9090${NC}"
    else
        echo "  ${RED}✗ Sing-Box 启动失败，请查看日志排查！${NC}"
    fi
}

# 3. 停止当前所有代理内核
stop_all() {
    echo "${YELLOW}正在停止所有代理核心与服务...${NC}"
    if [ -x "/etc/init.d/honk" ]; then
        /etc/init.d/honk stop 2>/dev/null
    fi
    graceful_stop_proc "honk-core|honk" "honk-core" 5
    killall -9 honk-core 2>/dev/null || true
    killall -9 honk 2>/dev/null || true
    cleanup_honk_leftovers

    /etc/init.d/sing-box stop 2>/dev/null
    graceful_stop_proc "sing-box run" "sing-box" 5
    cleanup_singbox_leftovers

    echo "正在恢复系统默认 DNS 与防火墙..."
    uci set dhcp.@dnsmasq[0].noresolv='0' 2>/dev/null
    uci -q delete dhcp.@dnsmasq[0].server 2>/dev/null
    uci commit dhcp 2>/dev/null
    /etc/init.d/dnsmasq restart 2>/dev/null

    uci set firewall.@defaults[0].flow_offloading='1' 2>/dev/null
    uci set firewall.@defaults[0].flow_offloading_hw='1' 2>/dev/null
    uci commit firewall 2>/dev/null
    /etc/init.d/firewall reload 2>/dev/null || /etc/init.d/firewall restart 2>/dev/null

    echo "${GREEN}✓ 所有代理核心已安全停止，网络已直连直通${NC}"
}

# 4. 重启当前正在运行的核心
restart_active() {
    get_status
    if [ "$HONK_ACTIVE" = "1" ]; then
        echo "${CYAN}正在重启 Honk...${NC}"
        if [ -x "/etc/init.d/honk" ]; then
            /etc/init.d/honk restart 2>/dev/null
        else
            killall -9 honk 2>/dev/null
            killall -9 honk-core 2>/dev/null
            ( trap "" HUP; honk-core --config /etc/honk/config.dae --store db --data-dir /etc/honk/data --log-file /var/log/honk.log >/dev/null 2>&1 ) </dev/null &
        fi
        echo "${GREEN}✓ Honk 重启完成${NC}"
    elif [ "$SB_ACTIVE" = "1" ]; then
        echo "${CYAN}正在重启 Sing-Box (裸核)...${NC}"
        /etc/init.d/sing-box restart
        echo "${GREEN}✓ Sing-Box 重启完成${NC}"
    else
        echo "${YELLOW}当前未检测到任何正在运行的核心，无需重启。${NC}"
    fi
}

# 5. 查看日志
view_logs() {
    target="$1"
    if [ -z "$target" ]; then
        get_status
        if [ "$HONK_ACTIVE" = "1" ]; then
            target="honk"
        else
            target="sing-box"
        fi
    fi

    echo "${CYAN}正在查看 ${target} 实时日志 (按 Ctrl+C 退出)...${NC}"
    if [ "$target" = "honk" ]; then
        if [ -f "/var/log/honk.log" ]; then
            tail -n 60 -f /var/log/honk.log
        else
            logread -f -e honk
        fi
    else
        logread -f -e sing-box
    fi
}

# 6. 从 GitHub 远程更新 Sing-Box 配置 (纯裸核)
update_singbox_config() {
    url_file="/etc/sing-box/config.url"
    cfg_file="/etc/sing-box/config.json"
    tmp_file="/tmp/sing-box-config.tmp.json"

    mkdir -p /etc/sing-box

    sub_url=""
    if [ -f "$url_file" ]; then
        sub_url=$(cat "$url_file" | tr -d '\r\n')
    fi

    if [ -z "$sub_url" ]; then
        printf "请输入 Sub-Store / GitHub 订阅链接: "
        read -r sub_url
        sub_url=$(echo "$sub_url" | tr -d '\r\n')
        if [ -z "$sub_url" ]; then
            echo "${RED}错误：订阅链接不能为空！${NC}"
            return 1
        fi
        echo "$sub_url" > "$url_file"
    fi

    echo "${CYAN}正在下载 Sing-Box 配置...${NC}"
    if curl -fsSL -m 30 "$sub_url" -o "$tmp_file"; then
        echo "正在校验配置..."
        if sing-box check -c "$tmp_file"; then
            mv -f "$tmp_file" "$cfg_file"
            echo "${GREEN}✓ 配置校验通过，正在重启 Sing-Box 裸核...${NC}"
            /etc/init.d/sing-box restart 2>/dev/null
            echo "${GREEN}✓ 重启完成。${NC}"
        else
            echo "${RED}警告：配置校验失败，已保留原有配置！${NC}"
            rm -f "$tmp_file"
            return 1
        fi
    else
        echo "${RED}错误：下载配置失败，请检查网络或链接！${NC}"
        rm -f "$tmp_file"
        return 1
    fi
}

# 7. 从 GitHub 远程更新 Honk (config.dae) 配置
update_honk_config() {
    url_file="/etc/honk/config.url"
    cfg_file="/etc/honk/config.dae"
    tmp_file="/tmp/honk-config.tmp.dae"

    mkdir -p /etc/honk

    remote_url=""
    if [ -f "$url_file" ]; then
        remote_url=$(cat "$url_file" | tr -d '\r\n')
    fi

    if [ -z "$remote_url" ]; then
        echo "${YELLOW}当前未保存 Honk 的 GitHub 远程文件链接。${NC}"
        printf "请输入您的 GitHub config.dae 链接 (例如 https://raw.githubusercontent.com/user/repo/main/config.dae): "
        read -r remote_url
        remote_url=$(echo "$remote_url" | tr -d '\r\n')
        if [ -z "$remote_url" ]; then
            echo "${RED}错误：远程链接不能为空！${NC}"
            return 1
        fi
        echo "$remote_url" > "$url_file"
        echo "${GREEN}✓ 远程订阅链接已保存至 $url_file${NC}"
    fi

    echo "${CYAN}正在从 GitHub / 订阅服务下载最新 config.dae...${NC}"
    echo "  URL: $remote_url"
    if curl -fsSL -m 30 "$remote_url" -o "$tmp_file"; then
        if grep -q "routing" "$tmp_file" && grep -q "global" "$tmp_file"; then
            mv -f "$tmp_file" "$cfg_file"
            echo "${GREEN}✓ Honk 配置文件下载并通过基本结构校验！${NC}"
            get_status
            was_honk_active="$HONK_ACTIVE"
            if [ "$was_honk_active" = "1" ] || pgrep honk-core >/dev/null 2>&1; then
                echo "${CYAN}Honk 正在运行，先停止进程以安全释放数据库句柄...${NC}"
                if [ -x "/etc/init.d/honk" ]; then
                    /etc/init.d/honk stop 2>/dev/null
                fi
                graceful_stop_proc "honk-core|honk" "honk-core" 5
                killall -9 honk-core 2>/dev/null || true
                killall -9 honk 2>/dev/null || true
                sleep 1
            fi
            # 归档旧数据库，确保下次启动或重启时自动导入全新 config.dae 为 Revision 1
            mv -f /etc/honk/data/state/honk.db /etc/honk/data/state/honk.db.bak 2>/dev/null || true
            rm -f /etc/honk/data/state/honk.db-shm /etc/honk/data/state/honk.db-wal 2>/dev/null || true
            if [ "$was_honk_active" = "1" ]; then
                echo "${CYAN}正在启动 Honk 并导入全新配置与状态库...${NC}"
                if [ -x "/etc/init.d/honk" ]; then
                    /etc/init.d/honk start 2>/dev/null
                else
                    ( trap "" HUP; honk-core --config /etc/honk/config.dae --store db --data-dir /etc/honk/data --log-file /var/log/honk.log >/dev/null 2>&1 ) </dev/null &
                fi
            fi
            echo "${GREEN}✓ 配置更新完毕。${NC}"
        else
            echo "${RED}警告：下载的文件内容缺失必要的 Honk 块（可能为 404 网页），已保留本地原配置！${NC}"
            rm -f "$tmp_file"
            return 1
        fi
    else
        echo "${RED}错误：下载失败，请检查网络或链接有效性！${NC}"
        rm -f "$tmp_file"
        return 1
    fi
}

# 8. 开启每日凌晨 4 点自动更新 Crontab
setup_cron() {
    cron_file="/etc/crontabs/root"
    mkdir -p /etc/crontabs
    touch "$cron_file"

    cron_job_sb="0 4 * * * /usr/bin/sb-honk update sb"
    cron_job_honk="10 4 * * * /usr/bin/sb-honk update honk"

    grep -Fq "/usr/bin/sb-honk update sb" "$cron_file" 2>/dev/null || echo "$cron_job_sb" >> "$cron_file"
    grep -Fq "/usr/bin/sb-honk update honk" "$cron_file" 2>/dev/null || echo "$cron_job_honk" >> "$cron_file"

    /etc/init.d/cron restart 2>/dev/null
    echo "${GREEN}✓ 每天凌晨 4 点自动从 GitHub 更新配置任务已配置完毕！${NC}"
}

# 9. 一键安装 / 升级 Sing-Box 核心 (可选稳定版或测试版)
install_singbox() {
    ver_choice="$1"
    if [ -z "$ver_choice" ]; then
        echo ""
        echo "${CYAN}${BOLD}======================================================${NC}"
        echo "${CYAN}${BOLD}       请选择要安装 / 升级的 Sing-Box 核心版本         ${NC}"
        echo "${CYAN}${BOLD}======================================================${NC}"
        echo " 1. 稳定版 (Stable - 推荐，适合日常高可靠网络环境)"
        echo " 2. 测试版 (Beta / Pre-release - 包含最新协议特性)"
        printf "${BOLD}请输入选项 [1-2, 默认 1]: ${NC}"
        read -r v_opt
        if [ "$v_opt" = "2" ] || [ "$v_opt" = "beta" ]; then
            ver_choice="beta"
        else
            ver_choice="stable"
        fi
    fi

    echo ""
    if [ "$ver_choice" = "beta" ]; then
        echo "${CYAN}${BOLD}>>> 正在通过官方安装脚本部署 Sing-Box [测试版 Beta / Pre-release]...${NC}"
        curl -fsSL https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-box/stable/docs/installation/tools/install.sh | sed 's#https://github.com/#https://gh-proxy.com/https://github.com/#' | sh -s -- --beta
    else
        echo "${CYAN}${BOLD}>>> 正在通过官方安装脚本部署 Sing-Box [稳定版 Stable]...${NC}"
        curl -fsSL https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-box/stable/docs/installation/tools/install.sh | sed 's#https://github.com/#https://gh-proxy.com/https://github.com/#' | sh
    fi

    uci set sing-box.main.enabled=1 2>/dev/null
    uci commit sing-box 2>/dev/null
    /etc/init.d/sing-box enable 2>/dev/null
    echo ""
    echo "${GREEN}${BOLD}🎉 Sing-Box 核心安装 / 升级完成！当前版本信息：${NC}"
    sing-box version 2>/dev/null | head -n 1
}

# 10. 一键安装 / 升级 Honk 静态核心 (支持 aarch64 全平台)
install_honk() {
    echo ""
    echo "${CYAN}${BOLD}>>> 正在下载并安装 Honk 官方最新静态二进制 (含 doona 面板)...${NC}"
    arch=$(uname -m)
    case "$arch" in
        aarch64|arm64) pkg_arch="aarch64" ;;
        x86_64|amd64) pkg_arch="x86_64" ;;
        *) echo "${RED}暂不支持该硬件架构: $arch${NC}"; return 1 ;;
    esac

    # 获取最新发布版本并下载 musl 静态完整版
    tar_url="https://gh-proxy.com/https://github.com/daeuniverse/honk/releases/download/v0.1.0-beta.6/honk-core-v0.1.0-beta.6-${pkg_arch}-unknown-linux-musl-full.tar.gz"
    echo "  下载地址: $tar_url"
    
    mkdir -p /tmp/honk_install /etc/honk
    if curl -fsSL -m 60 "$tar_url" -o /tmp/honk_install/honk.tar.gz; then
        tar -xzf /tmp/honk_install/honk.tar.gz -C /tmp/honk_install/
        cp -f /tmp/honk_install/honk-core-*/honk-core /usr/bin/honk
        chmod +x /usr/bin/honk
        rm -rf /tmp/honk_install
        
        # 补全 procd 服务
        if [ ! -f "/etc/init.d/honk" ]; then
            cat > /etc/init.d/honk <<'EOF'
#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10
PROG="/usr/bin/honk"
CONF="/etc/honk/config.dae"
LOGFILE="/var/log/honk.log"

start_service() {
    [ -f "$CONF" ] || return 1
    mkdir -p /sys/fs/bpf
    mount | grep -q "/sys/fs/bpf" || mount -t bpf bpffs /sys/fs/bpf 2>/dev/null
    mkdir -p /var/log /var/lib/honk
    procd_open_instance "honk"
    procd_set_param command "$PROG" -c "$CONF" --log-file "$LOGFILE"
    procd_set_param respawn
    procd_set_param limits core="unlimited"
    procd_set_param limits nofile="1000000 1000000"
    procd_close_instance
}
stop_service() { killall -9 honk-core 2>/dev/null; killall -9 honk 2>/dev/null || true; }
reload_service() { "$PROG" reload 2>/dev/null || restart; }
EOF
            chmod +x /etc/init.d/honk
        fi
        
        echo ""
        echo "${GREEN}${BOLD}🎉 Honk 核心安装完成！${NC}"
        /usr/bin/honk --help | head -n 3
    else
        echo "${RED}错误：下载 Honk 核心失败，请检查网络！${NC}"
        rm -rf /tmp/honk_install
        return 1
    fi
}

# 命令行直达快捷参数处理 (CLI Arguments)
case "$1" in
    honk|switch-honk|to-honk)
        switch_to_honk
        exit $?
        ;;
    singbox|sb|switch-sb|to-sb)
        switch_to_singbox
        exit $?
        ;;
    stop)
        stop_all
        exit $?
        ;;
    restart)
        restart_active
        exit $?
        ;;
    log|logs)
        view_logs "$2"
        exit 0
        ;;
    status)
        get_status
        echo "Sing-Box: $SB_STATE"
        echo "Honk:     $HONK_STATE"
        echo "FlowOff:  $FLOW_STATE"
        exit 0
        ;;
    update)
        if [ "$2" = "honk" ]; then
            update_honk_config
        else
            update_singbox_config
        fi
        exit $?
        ;;
    install-sb|install-singbox)
        install_singbox "$2"
        exit $?
        ;;
    install-honk)
        install_honk
        exit $?
        ;;
    apply-rps|rps)
        apply_rps_tuning "d"
        exit 0
        ;;
esac

# 交互式主菜单界面 (Interactive TUI Menu)
while true; do
    get_status
    clear 2>/dev/null || true
    echo "${PURPLE}${BOLD}======================================================${NC}"
    echo "       ${CYAN}${BOLD}PonWrt 双核透明代理管理面板 (sb-honk)${NC}"
    echo "${PURPLE}${BOLD}======================================================${NC}"
    echo "  ${BOLD}当前核心状态：${NC}"
    echo "   • Sing-Box : $SB_STATE"
    echo "   • Honk     : $HONK_STATE"
    echo "   • 防火墙   : $FLOW_STATE"
    echo "   • DNS 模式 : $DNS_STATE"
    echo "${PURPLE}------------------------------------------------------${NC}"
    echo "  ${BOLD}[一键互斥内核切换]${NC}"
    echo "   ${GREEN}${BOLD}1.${NC} 切换至 ${CYAN}${BOLD}Honk (eBPF 零开销旁路)${NC}  (自动停止 SB & 关闭流分流)"
    echo "   ${GREEN}${BOLD}2.${NC} 切换至 ${YELLOW}${BOLD}Sing-Box (TUN 裸核模式)${NC} (自动停止 Honk & 恢复流分流)"
    echo ""
    echo "  ${BOLD}[服务启停与维护]${NC}"
    echo "   ${BLUE}3.${NC} 重启当前运行的核心"
    echo "   ${BLUE}4.${NC} 停止所有核心 (完全断开代理直通网络)"
    echo "   ${BLUE}5.${NC} 查看实时运行日志 (动态追踪)"
    echo ""
    echo "  ${BOLD}[GitHub 远程配置同步与安装]${NC}"
    echo "   ${MAGENTA}6.${NC} 从 GitHub 远程更新 ${YELLOW}Sing-Box${NC} 配置"
    echo "   ${MAGENTA}7.${NC} 从 GitHub 远程更新 ${CYAN}Honk${NC} (config.dae) 配置"
    echo "   ${MAGENTA}8.${NC} 开启每天凌晨 4 点自动从 GitHub 同步配置 (Crontab)"
    echo "   ${MAGENTA}9.${NC} 一键安装 / 升级 ${YELLOW}Sing-Box${NC} 核心 (可选稳定版或测试版)"
    echo "   ${MAGENTA}10.${NC} 一键安装 / 升级 ${CYAN}Honk${NC} 官方核心 (全功能版)"
    echo ""
    echo "   ${RED}0. 退出面板${NC}"
    echo "${PURPLE}${BOLD}======================================================${NC}"
    printf "${BOLD}请选择操作 [0-10]: ${NC}"
    read -r choice
    case "$choice" in
        1)
            switch_to_honk
            printf "\n按 Enter 键返回主菜单..."
            read -r _
            ;;
        2)
            switch_to_singbox
            printf "\n按 Enter 键返回主菜单..."
            read -r _
            ;;
        3)
            restart_active
            printf "\n按 Enter 键返回主菜单..."
            read -r _
            ;;
        4)
            stop_all
            printf "\n按 Enter 键返回主菜单..."
            read -r _
            ;;
        5)
            echo "请选择要查看的日志类型:"
            echo " 1. 查看 Sing-Box 日志"
            echo " 2. 查看 Honk 日志"
            printf "请选择 [1-2, 默认跟随当前核心]: "
            read -r log_opt
            if [ "$log_opt" = "1" ]; then
                view_logs "sing-box"
            elif [ "$log_opt" = "2" ]; then
                view_logs "honk"
            else
                view_logs ""
            fi
            printf "\n按 Enter 键返回主菜单..."
            read -r _
            ;;
        6)
            update_singbox_config
            printf "\n按 Enter 键返回主菜单..."
            read -r _
            ;;
        7)
            update_honk_config
            printf "\n按 Enter 键返回主菜单..."
            read -r _
            ;;
        8)
            setup_cron
            printf "\n按 Enter 键返回主菜单..."
            read -r _
            ;;
        9)
            install_singbox ""
            printf "\n按 Enter 键返回主菜单..."
            read -r _
            ;;
        10)
            install_honk
            printf "\n按 Enter 键返回主菜单..."
            read -r _
            ;;
        0)
            echo "已退出。"
            exit 0
            ;;
        *)
            echo "${RED}无效选项，请重新输入！${NC}"
            sleep 1
            ;;
    esac
done
