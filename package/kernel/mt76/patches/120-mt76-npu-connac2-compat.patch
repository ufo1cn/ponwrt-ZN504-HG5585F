From: PonWrt <dev@ponwrt.local>
Subject: [PATCH] wifi: mt76: npu: add Connac2 (MT7916) RX-only compatibility

MT7916 (Connac2) does not support HW-RRO v3/v3.1, and on Airoha EN7581
its vendor 98K NPU firmware offloads WiFi RX only while TX is handled
orthogonally by WED v1 (or standard host WFDMA).

1. Skip setting dev->hwrro_mode and dev->rx_token_size = 32768 for
   MT7915/MT7916 in mt76_npu_init(), and preserve dev->dma_dev when WED
   is already active.
2. Check mt76_queue_is_npu_tx(q) instead of mt76_npu_device_active(dev)
   in mt76_dma_tx_queue_skb() so RX-only NPU devices do not divert
   WED/WFDMA TX queues into mt76_npu_dma_add_buf().

Signed-off-by: PonWrt <dev@ponwrt.local>
---
diff --git a/dma.c b/dma.c
index a67880a..0cb0f08 100644
--- a/dma.c
+++ b/dma.c
@@ -686,7 +686,7 @@ mt76_dma_tx_queue_skb(struct mt76_phy *phy, struct mt76_queue *q,
 		goto free_skb;
 
 	/* TODO: Take into account unlinear skbs */
-	if (mt76_npu_device_active(dev) && skb_linearize(skb))
+	if (mt76_queue_is_npu_tx(q) && skb_linearize(skb))
 		goto free_skb;
 
 	t = mt76_get_txwi(dev);
@@ -738,7 +738,7 @@ mt76_dma_tx_queue_skb(struct mt76_phy *phy, struct mt76_queue *q,
 	if (ret < 0)
 		goto unmap;
 
-	if (mt76_npu_device_active(dev))
+	if (mt76_queue_is_npu_tx(q))
 		return mt76_npu_dma_add_buf(phy, q, skb, &tx_info.buf[1], txwi);
 
 	return mt76_dma_add_buf(dev, q, tx_info.buf, tx_info.nbuf,
diff --git a/npu.c b/npu.c
index dd954df..e363824 100644
--- a/npu.c
+++ b/npu.c
@@ -471,12 +471,15 @@ int mt76_npu_init(struct mt76_dev *dev, phys_addr_t phy_addr, int type)
 	if (err)
 		goto error_ppe_put;
 
-	dev->dma_dev = npu->dev;
+	if (!mtk_wed_device_active(&dev->mmio.wed))
+		dev->dma_dev = npu->dev;
 	dev->mmio.phy_addr = phy_addr;
 	dev->mmio.npu_type = type;
-	/* NPU offloading requires HW-RRO for RX packet reordering. */
-	dev->hwrro_mode = is_mt7996(dev) ? MT76_HWRRO_V3 : MT76_HWRRO_V3_1;
-	dev->rx_token_size = 32768;
+	if (!is_mt7915(dev) && !is_mt7916(dev)) {
+		/* NPU offloading requires HW-RRO for RX packet reordering. */
+		dev->hwrro_mode = is_mt7996(dev) ? MT76_HWRRO_V3 : MT76_HWRRO_V3_1;
+		dev->rx_token_size = 32768;
+	}
 
 	rcu_assign_pointer(dev->mmio.npu, npu);
 	rcu_assign_pointer(dev->mmio.ppe_dev, ppe_dev);
