diff --git a/mt7915/npu.c b/mt7915/npu.c
new file mode 100644
index 0000000..fcb1030
--- /dev/null
+++ b/mt7915/npu.c
@@ -0,0 +1,293 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * Copyright (C) 2026 PonWrt / Airoha EN7581 MT7916 NPU RX offload
+ */
+#include <linux/kernel.h>
+#include <linux/soc/airoha/airoha_offload.h>
+
+#include "mt7915.h"
+#include "../dma.h"
+
+#define MT7916_NPU_DRIVER_MODEL		2
+
+#define MT7916_NPU_BA_WIN_TID_MASK	GENMASK(2, 0)
+#define MT7916_NPU_BA_WIN_WCID_MASK	GENMASK(10, 3)
+#define MT7916_NPU_BA_WIN_SIZE_MASK	GENMASK(19, 11)
+#define MT7916_NPU_BA_WIN_SSN_MASK	GENMASK(31, 20)
+
+#define MT7916_NPU_BAR_TID_MASK		GENMASK(2, 0)
+#define MT7916_NPU_BAR_WCID_MASK	GENMASK(10, 3)
+#define MT7916_NPU_BAR_SSN_MASK		GENMASK(22, 11)
+
+static void mt7915_npu_hostadpt_rx_cb(void *priv, int ring,
+				      struct sk_buff *skb,
+				      u32 info, u32 data)
+{
+	struct mt7915_dev *dev = priv;
+	enum mt76_rxq_id qid = ring ? MT_RXQ_NPU1 : MT_RXQ_NPU0;
+
+	skb_reset_mac_header(skb);
+	mt7915_queue_rx_skb(&dev->mt76, qid, skb, &info);
+	mt76_rx_poll_complete(&dev->mt76, qid, NULL);
+}
+
+static int mt7915_npu_band_init(struct mt7915_dev *dev,
+				struct airoha_npu *npu, int band)
+{
+	u32 hif1_ofs = dev->hif2 ? MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0) : 0;
+	enum mt76_rxq_id qid = band ? MT_RXQ_BAND1 : MT_RXQ_MAIN;
+	struct mt76_queue *q = &dev->mt76.q_rx[qid];
+	u32 rx_ring_pa, rxd_base;
+	int err;
+
+	if (!q->ndesc)
+		return 0;
+
+	/* SET_WAIT[5]: DRIVER_MODEL (MT7916 = 2) */
+	err = mt76_npu_send_msg(npu, band, WLAN_FUNC_SET_WAIT_DRIVER_MODEL,
+				MT7916_NPU_DRIVER_MODEL, GFP_KERNEL);
+	if (err) {
+		dev_warn(dev->mt76.dev,
+			 "failed setting NPU driver model for band %d: %d\n",
+			 band, err);
+		return err;
+	}
+
+	/*
+	 * SET_WAIT[0]: PCIE_ADDR (BAR0 + WFDMA RX data ring register offset).
+	 * Band0: BAR0 + 0xd4500 + 4 * 0x10 = BAR0 + 0xd4540
+	 * Band1: BAR0 + 0xd4500 + hif1_ofs + 5 * 0x10 = BAR0 + 0xd8550 (dual-PCIe)
+	 */
+	rx_ring_pa = dev->mt76.mmio.phy_addr + MT_RXQ_RING_BASE(qid) +
+		     MT_RXQ_ID(qid) * MT_RING_SIZE;
+	if (band)
+		rx_ring_pa += hif1_ofs;
+
+	err = mt76_npu_send_msg(npu, band, WLAN_FUNC_SET_WAIT_PCIE_ADDR,
+				rx_ring_pa, GFP_KERNEL);
+	if (err) {
+		dev_warn(dev->mt76.dev,
+			 "failed setting NPU PCIe RX ring addr for band %d: %d\n",
+			 band, err);
+		return err;
+	}
+
+	/* SET_WAIT[1]: DESC (RX ring size, vendor 98K hard limit 1..768) */
+	err = mt76_npu_send_msg(npu, band, WLAN_FUNC_SET_WAIT_DESC,
+				MT7915_NPU_RX_RING_SIZE, GFP_KERNEL);
+	if (err) {
+		dev_warn(dev->mt76.dev,
+			 "failed setting NPU RX desc size for band %d: %d\n",
+			 band, err);
+		return err;
+	}
+
+	/* GET_WAIT[4]: RXDESC_BASE -> program WFDMA RX ring DESC_BASE */
+	err = mt76_npu_get_msg(npu, band, WLAN_FUNC_GET_WAIT_RXDESC_BASE,
+			       &rxd_base, GFP_KERNEL);
+	if (err) {
+		dev_warn(dev->mt76.dev,
+			 "failed retrieving NPU RX desc base for band %d: %d\n",
+			 band, err);
+		return err;
+	}
+
+	writel(rxd_base, &q->regs->desc_base);
+	writel(MT7915_NPU_RX_RING_SIZE, &q->regs->ring_size);
+	writel(MT7915_NPU_RX_RING_SIZE - 1, &q->regs->cpu_idx);
+
+	dev_info(dev->mt76.dev,
+		 "NPU band%d RX offload initialized (reg=0x%08x, rxd=0x%08x, ndesc=%u)\n",
+		 band, rx_ring_pa, rxd_base, MT7915_NPU_RX_RING_SIZE);
+
+	return 0;
+}
+
+int mt7915_npu_rx_queues_init(struct mt7915_dev *dev)
+{
+	struct airoha_npu *npu;
+	int err;
+
+	if (!mt76_npu_device_active(&dev->mt76))
+		return 0;
+
+	/*
+	 * In MT7916 98K RX-only mode, airoha_npu has already pre-initialized
+	 * the 2 hostadpt slow-path RX rings (REG_RX_BASE(0/1) & IRQs) prior to
+	 * NPU core0 boot; do not overwrite them with mt76_npu_rx_queue_init().
+	 */
+	rcu_read_lock();
+	npu = rcu_dereference(dev->mt76.mmio.npu);
+	if (airoha_npu_is_mt7916_rx_only(npu)) {
+		rcu_read_unlock();
+		return 0;
+	}
+	rcu_read_unlock();
+
+	err = mt76_npu_rx_queue_init(&dev->mt76,
+				     &dev->mt76.q_rx[MT_RXQ_NPU0]);
+	if (err)
+		return err;
+
+	return mt76_npu_rx_queue_init(&dev->mt76,
+				      &dev->mt76.q_rx[MT_RXQ_NPU1]);
+}
+
+int __mt7915_npu_hw_init(struct mt7915_dev *dev)
+{
+	struct airoha_npu *npu;
+	int i, err;
+
+	npu = rcu_dereference_protected(dev->mt76.mmio.npu,
+					lockdep_is_held(&dev->mt76.mutex));
+	if (!npu)
+		return 0;
+
+	/*
+	 * Vendor 98K init sequence:
+	 * SET_WAIT[18] NPU_BAND0_ONCPU -> SET_WAIT[8] PKT_BUF_ADDR ->
+	 * SET_WAIT[7] DRAM_BA_NODE_ADDR -> SET_WAIT[12] IS_FORCE_TO_CPU
+	 */
+	err = airoha_npu_wlan_init_reserved_memory(npu);
+	if (err) {
+		dev_warn(dev->mt76.dev,
+			 "failed initializing NPU reserved memory: %d\n", err);
+		return err;
+	}
+
+	/* SET_WAIT[14]: PCIE_PORT_TYPE */
+	err = mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_PCIE_PORT_TYPE,
+				dev->mt76.mmio.npu_type, GFP_KERNEL);
+	if (err) {
+		dev_warn(dev->mt76.dev,
+			 "failed setting NPU PCIe port type: %d\n", err);
+		return err;
+	}
+
+	/* Per-band: SET_WAIT[5] -> SET_WAIT[0] -> SET_WAIT[1] -> GET_WAIT[4] */
+	err = mt7915_npu_band_init(dev, npu, MT_BAND0);
+	if (err)
+		return err;
+
+	if (dev->dbdc_support) {
+		err = mt7915_npu_band_init(dev, npu, MT_BAND1);
+		if (err)
+			return err;
+	}
+
+	/* SET_WAIT[2]: NPU_INIT_DONE */
+	mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_NPU_INIT_DONE,
+			  1, GFP_KERNEL);
+
+	if (airoha_npu_is_mt7916_rx_only(npu))
+		airoha_npu_hostadpt_register_rx_cb(npu,
+						   mt7915_npu_hostadpt_rx_cb,
+						   dev);
+
+	for (i = MT_RXQ_NPU0; i <= MT_RXQ_NPU1; i++)
+		airoha_npu_wlan_enable_irq(npu, i - MT_RXQ_NPU0);
+
+	return 0;
+}
+
+int mt7915_npu_hw_init(struct mt7915_dev *dev)
+{
+	int err;
+
+	mutex_lock(&dev->mt76.mutex);
+	err = __mt7915_npu_hw_init(dev);
+	mutex_unlock(&dev->mt76.mutex);
+
+	return err;
+}
+
+int __mt7915_npu_hw_stop(struct mt7915_dev *dev)
+{
+	struct airoha_npu *npu;
+
+	npu = rcu_dereference_protected(dev->mt76.mmio.npu,
+					lockdep_is_held(&dev->mt76.mutex));
+	if (!npu)
+		return 0;
+
+	if (airoha_npu_is_mt7916_rx_only(npu))
+		airoha_npu_hostadpt_unregister_rx_cb(npu);
+	else
+		mt76_npu_disable_irqs(&dev->mt76);
+
+	/*
+	 * Vendor 98K firmware does not implement INODE_TXRX_REG_ADDR stop.
+	 * Switch NPU RX path to force-to-CPU during teardown/reset.
+	 */
+	return mt76_npu_send_msg(npu, 0, WLAN_FUNC_SET_WAIT_IS_FORCE_TO_CPU,
+				 1, GFP_KERNEL);
+}
+
+int mt7915_npu_hw_stop(struct mt7915_dev *dev)
+{
+	int err;
+
+	mutex_lock(&dev->mt76.mutex);
+	err = __mt7915_npu_hw_stop(dev);
+	mutex_unlock(&dev->mt76.mutex);
+
+	return err;
+}
+
+void mt7915_npu_sta_update(struct mt7915_dev *dev, u8 band_idx, u16 wcid)
+{
+	struct airoha_npu *npu;
+
+	if (!mt76_npu_device_active(&dev->mt76))
+		return;
+
+	rcu_read_lock();
+	npu = rcu_dereference(dev->mt76.mmio.npu);
+	if (npu)
+		mt76_npu_send_msg(npu, band_idx, WLAN_FUNC_SET_WAIT_DEL_STA,
+				  wcid & 0xffff, GFP_ATOMIC);
+	rcu_read_unlock();
+}
+
+void mt7915_npu_ba_update(struct mt7915_dev *dev, u8 band_idx, u16 wcid,
+			  u8 tid, u16 ssn, u16 buf_size)
+{
+	struct airoha_npu *npu;
+	u32 val;
+
+	if (!mt76_npu_device_active(&dev->mt76))
+		return;
+
+	val = FIELD_PREP(MT7916_NPU_BA_WIN_TID_MASK, tid & 0x7) |
+	      FIELD_PREP(MT7916_NPU_BA_WIN_WCID_MASK, wcid & 0xff) |
+	      FIELD_PREP(MT7916_NPU_BA_WIN_SIZE_MASK, buf_size & 0x1ff) |
+	      FIELD_PREP(MT7916_NPU_BA_WIN_SSN_MASK, ssn & 0xfff);
+
+	rcu_read_lock();
+	npu = rcu_dereference(dev->mt76.mmio.npu);
+	if (npu)
+		mt76_npu_send_msg(npu, band_idx, WLAN_FUNC_SET_WAIT_BA_WIN_SIZE,
+				  val, GFP_ATOMIC);
+	rcu_read_unlock();
+}
+
+void mt7915_npu_bar_info(struct mt7915_dev *dev, u8 band_idx, u16 wcid,
+			 u8 tid, u16 ssn)
+{
+	struct airoha_npu *npu;
+	u32 val;
+
+	if (!mt76_npu_device_active(&dev->mt76))
+		return;
+
+	val = FIELD_PREP(MT7916_NPU_BAR_TID_MASK, tid & 0x7) |
+	      FIELD_PREP(MT7916_NPU_BAR_WCID_MASK, wcid & 0xff) |
+	      FIELD_PREP(MT7916_NPU_BAR_SSN_MASK, ssn & 0xfff);
+
+	rcu_read_lock();
+	npu = rcu_dereference(dev->mt76.mmio.npu);
+	if (npu)
+		mt76_npu_send_msg(npu, band_idx, WLAN_FUNC_SET_WAIT_BAR_INFO,
+				  val, GFP_ATOMIC);
+	rcu_read_unlock();
+}
