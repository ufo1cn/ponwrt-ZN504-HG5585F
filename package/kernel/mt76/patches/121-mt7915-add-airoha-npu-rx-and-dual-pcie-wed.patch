From: PonWrt <dev@ponwrt.local>
Subject: [PATCH] wifi: mt76: mt7915: add Airoha EN7581 NPU RX offload and dual-PCIe WED support

Add Airoha EN7581 NPU WiFi RX hardware offload for MT7916D (dual-PCIe)
coexisting orthogonally with WED v1 TX offload:

1. mt7915/pci.c: initialize HIF2 (5GHz 14c3:790a) before WED/NPU probe so
   dual-PCIe HIF2 is not skipped when WED is active; initialize NPU on
   MT7916 alongside WED v1 TX.
2. mt7915/npu.c: implement vendor 98K NPU firmware exact init sequence
   (SET_WAIT[18->8->7->12->14->5->0->1->2] + GET_WAIT[4] programming
   dual-PCIe WFDMA RX ring DESC_BASE with 768 descriptors), register the
   hostadpt slow-path RX callback (airoha_npu_hostadpt_register_rx_cb),
   and implement runtime callbacks for STA add/remove (SET_WAIT[6]), RX
   BA start/stop (SET_WAIT[4]), and BAR frames (SET_WAIT[16]).
3. mt7915/{dma,mmio,init,main,mac}.c: wire NPU RX queues, mask WFDMA RX
   data interrupts when NPU owns RX, enable NETIF_F_HW_TC and
   net_setup_tc/net_fill_forward_path (passing actual WCID when NPU is
   active), hook mt76_npu_check_ppe() and SER reset stop/re-init.

Signed-off-by: PonWrt <dev@ponwrt.local>
---
diff --git a/mt7915/Makefile b/mt7915/Makefile
index 7ea5b05..25cfc60 100644
--- a/mt7915/Makefile
+++ b/mt7915/Makefile
@@ -9,3 +9,4 @@ mt7915e-y := pci.o init.o dma.o eeprom.o main.o mcu.o mac.o \
 mt7915e-$(CONFIG_NL80211_TESTMODE) += testmode.o
 mt7915e-$(CONFIG_MT798X_WMAC) += soc.o
 mt7915e-$(CONFIG_DEV_COREDUMP) += coredump.o
+mt7915e-$(CONFIG_MT7915_NPU) += npu.o
diff --git a/mt7915/dma.c b/mt7915/dma.c
index aabd373..78bfe29 100644
--- a/mt7915/dma.c
+++ b/mt7915/dma.c
@@ -300,11 +300,13 @@ int mt7915_dma_start(struct mt7915_dev *dev, bool reset, bool wed_reset)
 		   MT_INT_TX_DONE_MCU |
 		   MT_INT_MCU_CMD;
 
-	if (!dev->phy.mt76->band_idx)
-		irq_mask |= MT_INT_BAND0_RX_DONE;
+	if (!mt76_npu_device_active(&dev->mt76)) {
+		if (!dev->phy.mt76->band_idx)
+			irq_mask |= MT_INT_BAND0_RX_DONE;
 
-	if (dev->dbdc_support || dev->phy.mt76->band_idx)
-		irq_mask |= MT_INT_BAND1_RX_DONE;
+		if (dev->dbdc_support || dev->phy.mt76->band_idx)
+			irq_mask |= MT_INT_BAND1_RX_DONE;
+	}
 
 	if (mtk_wed_device_active(&dev->mt76.mmio.wed) && wed_reset) {
 		u32 wed_irq_mask = irq_mask;
@@ -408,6 +410,8 @@ static int mt7915_dma_enable(struct mt7915_dev *dev, bool reset)
 int mt7915_dma_init(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 {
 	struct mt76_dev *mdev = &dev->mt76;
+	u32 rx_ring_size = mt76_npu_device_active(mdev) ?
+			   MT7915_NPU_RX_RING_SIZE : MT7915_RX_RING_SIZE;
 	u32 wa_rx_base, wa_rx_idx;
 	u32 hif1_ofs = 0;
 	int ret;
@@ -518,7 +522,7 @@ int mt7915_dma_init(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 
 		ret = mt76_queue_alloc(dev, &dev->mt76.q_rx[MT_RXQ_MAIN],
 				       MT_RXQ_ID(MT_RXQ_MAIN),
-				       MT7915_RX_RING_SIZE,
+				       rx_ring_size,
 				       MT_RX_BUF_SIZE,
 				       MT_RXQ_RING_BASE(MT_RXQ_MAIN));
 		if (ret)
@@ -558,7 +562,7 @@ int mt7915_dma_init(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 		/* rx data queue for band1 */
 		ret = mt76_queue_alloc(dev, &dev->mt76.q_rx[MT_RXQ_BAND1],
 				       MT_RXQ_ID(MT_RXQ_BAND1),
-				       MT7915_RX_RING_SIZE,
+				       rx_ring_size,
 				       MT_RX_BUF_SIZE,
 				       MT_RXQ_RING_BASE(MT_RXQ_BAND1) + hif1_ofs);
 		if (ret)
@@ -578,6 +582,10 @@ int mt7915_dma_init(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 	if (ret < 0)
 		return ret;
 
+	ret = mt7915_npu_rx_queues_init(dev);
+	if (ret < 0)
+		return ret;
+
 	netif_napi_add_tx(dev->mt76.tx_napi_dev, &dev->mt76.tx_napi,
 			  mt7915_poll_tx);
 	napi_enable(&dev->mt76.tx_napi);
@@ -613,6 +621,8 @@ int mt7915_dma_reset(struct mt7915_dev *dev, bool force)
 	if (mtk_wed_device_active(wed))
 		mtk_wed_device_dma_reset(wed);
 
+	if (!airoha_npu_is_mt7916_rx_only(rcu_access_pointer(dev->mt76.mmio.npu)))
+		mt76_npu_disable_irqs(&dev->mt76);
 	mt7915_dma_disable(dev, force);
 	mt76_wed_dma_reset(&dev->mt76);
 
@@ -627,7 +637,8 @@ int mt7915_dma_reset(struct mt7915_dev *dev, bool force)
 		mt76_queue_reset(dev, dev->mt76.q_mcu[i], true);
 
 	mt76_for_each_q_rx(&dev->mt76, i) {
-		if (mt76_queue_is_wed_tx_free(&dev->mt76.q_rx[i]))
+		if (mt76_queue_is_wed_tx_free(&dev->mt76.q_rx[i]) ||
+		    mt76_queue_is_npu_txfree(&dev->mt76.q_rx[i]))
 			continue;
 
