--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -523,11 +523,22 @@ mt7915_mac_fill_rx(struct mt7915_dev *dev, struct sk_buff *skb,
 		if (ieee80211_is_data_qos(fc)) {
 			seq_ctrl = le16_to_cpu(hdr->seq_ctrl);
 			qos_ctl = *ieee80211_get_qos_ctl(hdr);
+		} else if (ieee80211_is_back_req(fc) && status->wcid &&
+			   skb->len >= sizeof(struct ieee80211_bar)) {
+			struct ieee80211_bar *bar = (struct ieee80211_bar *)hdr;
+			u16 ctrl = le16_to_cpu(bar->control);
+			u16 ssn = IEEE80211_SEQ_TO_SN(le16_to_cpu(bar->start_seq_num));
+			u8 tid = (ctrl & IEEE80211_BAR_CTRL_TID_INFO_MASK) >>
+				 IEEE80211_BAR_CTRL_TID_INFO_SHIFT;
+
+			mt7915_npu_bar_info(dev, phy->mt76->band_idx,
+					    status->wcid->idx, tid, ssn);
 		}
 	} else {
 		status->flag |= RX_FLAG_8023;
 		mt7915_wed_check_ppe(dev, &dev->mt76.q_rx[q], msta, skb,
 				     *info);
+		mt76_npu_check_ppe(&dev->mt76, skb, *info);
 	}
 
 	if (rxv && mode >= MT_PHY_TYPE_HE_SU && !(status->flag & RX_FLAG_8023))
@@ -1544,6 +1555,8 @@ void mt7915_mac_reset_work(struct work_struct *work)
