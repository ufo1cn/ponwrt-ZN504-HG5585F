# /etc/config/bt-keys —— 蓝牙 HID 动作映射（供 /usr/bin/bt-keyaction 查询）
#
# section 名就是动作名，option cmd 是动作要执行的命令（sh -c 执行）。
# 默认值只写日志，确认设备和按键都通之后再换成真实命令，例如：
#   uci set bt-keys.ok.cmd='ubus call session ...'
#   uci commit bt-keys

config action 'playpause'
	option cmd 'logger -t bt-key "playpause 按下"'

config action 'next'
	option cmd 'logger -t bt-key "next 按下"'

config action 'prev'
	option cmd 'logger -t bt-key "prev 按下"'

config action 'volup'
	option cmd 'logger -t bt-key "volup 按下"'

config action 'voldown'
	option cmd 'logger -t bt-key "voldown 按下"'

config action 'mute'
	option cmd 'logger -t bt-key "mute 按下"'

config action 'up'
	option cmd 'logger -t bt-key "up 按下"'

config action 'down'
	option cmd 'logger -t bt-key "down 按下"'

config action 'left'
	option cmd 'logger -t bt-key "left 按下"'

config action 'right'
	option cmd 'logger -t bt-key "right 按下"'

config action 'ok'
	option cmd 'logger -t bt-key "ok 按下"'

config action 'back'
	option cmd 'logger -t bt-key "back 按下"'

config action 'home'
	option cmd 'logger -t bt-key "home 按下"'

config action 'power'
	option cmd 'logger -t bt-key "power 按下（默认不重启，确认后改成 reboot）"'
