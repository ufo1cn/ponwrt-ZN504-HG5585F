#!/bin/sh /etc/rc.common
# Triggerhappy 服务：监听所有 /dev/input/event*，规则读 /etc/triggerhappy/triggers.d
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/thd \
		--triggers /etc/triggerhappy/triggers.d \
		--socket /var/run/triggerhappy.sock \
		--deviceglob "/dev/input/event*"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_set_param file /etc/triggerhappy/triggers.d/bt-hid.conf
	procd_close_instance
}

reload_service() {
	stop
	start
}
