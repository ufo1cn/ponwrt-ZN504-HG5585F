config camwatch 'main'
	option enabled '1'

	# camlive 的 HTTP 端口（默认 RTSP 8554 + 1）
	option snapshot_url 'http://127.0.0.1:8555/snapshot.jpg'
	option status_url 'http://127.0.0.1:8555/status.json'
	option rtsp_url 'rtsp://127.0.0.1:8554/'

	# 取一帧做变化检测的间隔（秒）
	option interval '1'
	# 变化门限：32x24 灰度帧的平均绝对差（千分比 0..1000），越大越迟钝
	option motion_threshold '60'

	# 判定"人已离开"所需的连续无人次数与保持秒数
	option hold_seconds '25'
	option miss_limit '2'

	# 事件录像的存放位置（建议挂载在 USB 盘上）
	option record_dir '/mnt/usb/cam'
	# 环形录制：每片秒数、保留片数（总要覆盖 预录 + 保持）
	option segment_seconds '5'
	option ring_segments '8'
	option prebuffer_seconds '10'

	# 清理：最多保留天数、事件目录容量上限（MB）
	option max_days '7'
	option max_mb '8192'

	# 判人命令：接收一个 JPEG 路径作为 $1，返回 0=有人 1=无人 其他=接口异常
	# 留空则退化为"有变化就录"，不调用任何模型
	option detect_cmd '/usr/share/camwatch/detect-openai.sh'
	option detect_timeout '8'

	# 供 detect-openai.sh 使用（OpenAI 兼容的视觉接口）
	option api_url ''
	option api_key ''
	option model ''
	option prompt '画面里有没有人？只回答一个数字，有人回答 1，没有回答 0。'
