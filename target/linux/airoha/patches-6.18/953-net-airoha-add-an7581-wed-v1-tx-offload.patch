+static u32 airoha_wed_irq_get(struct mtk_wed_device *dev, u32 mask)
+{
+	u32 ext_val, val;
+
+	ext_val = airoha_wed_r32(dev, AIROHA_WED_EXT_INT_STATUS);
+	if (ext_val)
+		airoha_wed_w32(dev, AIROHA_WED_EXT_INT_STATUS, ext_val);
+
+	val = airoha_wed_r32(dev, AIROHA_WED_INT_STATUS);
+	val &= mask;
+	airoha_wed_w32(dev, AIROHA_WED_INT_STATUS, val);
+
+	return val;
+}
+
+static void airoha_wed_irq_set_mask(struct mtk_wed_device *dev, u32 mask)
+{
+	airoha_wed_w32(dev, AIROHA_WED_WPDMA_INT_MASK,
+		       mask ? AIROHA_WED_WPDMA_INT_MASK_TX01_RX1 : 0);
+	airoha_wed_w32(dev, AIROHA_WED_INT_MASK, mask);
+}
+
+static int airoha_wed_setup_tc_block_cb(enum tc_setup_type type,
+					void *type_data, void *cb_priv)
+{
+	struct mtk_wed_hw *hw = cb_priv;
+	struct airoha_eth *eth = hw->eth;
+
+	if (type != TC_SETUP_CLSFLOWER)
+		return -EOPNOTSUPP;
+
+	return airoha_ppe_dev_setup_tc_block_cb(&eth->ppe->dev, type_data);
+}
+
+static int airoha_wed_setup_tc(struct mtk_wed_device *wed,
+			       struct net_device *dev,
+			       enum tc_setup_type type, void *type_data)
+{
+	struct flow_block_offload *f = type_data;
+	struct mtk_wed_hw *hw = wed->hw;
+	static LIST_HEAD(block_cb_list);
+	struct flow_block_cb *block_cb;
+
+	if (type != TC_SETUP_BLOCK && type != TC_SETUP_FT)
+		return -EOPNOTSUPP;
+
+	if (f->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS)
+		return -EOPNOTSUPP;
+
+	f->driver_block_list = &block_cb_list;
+
+	switch (f->command) {
+	case FLOW_BLOCK_BIND:
+		block_cb = flow_block_cb_lookup(f->block,
+						airoha_wed_setup_tc_block_cb,
+						hw);
+		if (block_cb) {
+			flow_block_cb_incref(block_cb);
+			return 0;
+		}
+		block_cb = flow_block_cb_alloc(airoha_wed_setup_tc_block_cb,
+					       hw, hw, NULL);
+		if (IS_ERR(block_cb))
+			return PTR_ERR(block_cb);
+
+		flow_block_cb_incref(block_cb);
+		flow_block_cb_add(block_cb, f);
+		list_add_tail(&block_cb->driver_list, &block_cb_list);
+		return 0;
+	case FLOW_BLOCK_UNBIND:
+		block_cb = flow_block_cb_lookup(f->block,
+						airoha_wed_setup_tc_block_cb,
+						hw);
+		if (!block_cb)
+			return -ENOENT;
+
+		if (!flow_block_cb_decref(block_cb)) {
+			flow_block_cb_remove(block_cb, f);
+			list_del(&block_cb->driver_list);
+		}
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static struct mtk_wed_hw *airoha_wed_assign(struct mtk_wed_device *dev)
+{
+	struct mtk_wed_hw *hw = NULL;
+	int i, slot = -1;
+
+	if (dev->wlan.bus_type == MTK_WED_BUS_PCIE && dev->wlan.pci_dev)
+		slot = pci_domain_nr(dev->wlan.pci_dev->bus);
+
+	/* Prefer matching PCIe RC domain (pcie0 -> WED0, pcie1 -> WED1) */
+	if (slot >= 0 && slot < AIROHA_WED_MAX_DEVS &&
+	    airoha_wed_hw_list[slot] && !airoha_wed_hw_list[slot]->wed_dev) {
+		hw = airoha_wed_hw_list[slot];
+		goto found;
+	}
+
+	for (i = 0; i < AIROHA_WED_MAX_DEVS; i++) {
+		if (airoha_wed_hw_list[i] && !airoha_wed_hw_list[i]->wed_dev) {
+			hw = airoha_wed_hw_list[i];
+			break;
+		}
+	}
+
+found:
+	if (hw)
+		hw->wed_dev = dev;
+
+	return hw;
+}
+
+static void __airoha_wed_detach(struct mtk_wed_device *dev)
+{
+	struct mtk_wed_hw *hw = dev->hw;
+	int i;
+
+	if (!hw)
+		return;
+
+	airoha_wed_stop(dev);
+
+	for (i = 0; i < ARRAY_SIZE(dev->tx_ring); i++)
+		airoha_wed_ring_free(dev, &dev->tx_ring[i]);
+	for (i = 0; i < ARRAY_SIZE(dev->rx_wdma); i++)
+		airoha_wed_ring_free(dev, &dev->rx_wdma[i]);
+
+	airoha_wed_tx_buffer_free(dev);
+
+	hw->wed_dev = NULL;
+	dev->hw = NULL;
+	dev->init_done = false;
+	module_put(THIS_MODULE);
+}
+
+static void airoha_wed_detach(struct mtk_wed_device *dev)
+{
+	mutex_lock(&airoha_wed_lock);
+	__airoha_wed_detach(dev);
+	mutex_unlock(&airoha_wed_lock);
+}
+
+static int airoha_wed_attach(struct mtk_wed_device *dev)
+	__releases(RCU)
+{
+	struct mtk_wed_hw *hw;
+	int ret = 0;
+
+	if (!try_module_get(THIS_MODULE))
+		ret = -ENODEV;
+
+	rcu_read_unlock();
+
+	if (ret)
+		return ret;
+
+	mutex_lock(&airoha_wed_lock);
+
+	hw = airoha_wed_assign(dev);
+	if (!hw) {
+		module_put(THIS_MODULE);
+		ret = -ENODEV;
+		goto unlock;
+	}
+
+	dev->hw = hw;
+	dev->dev = hw->dev;
+	dev->irq = hw->irq;
+	dev->wdma_idx = hw->index;
+	dev->version = 1;
+	dev->rev_id = 0;
+
+	ret = dma_set_mask_and_coherent(hw->dev, DMA_BIT_MASK(32));
+	if (ret)
+		goto err_detach;
+
+	ret = airoha_wed_tx_buffer_alloc(dev);
+	if (ret)
+		goto err_detach;
+
+	airoha_wed_hw_init_early(dev);
+
+	dev_info(hw->dev, "attached AN7581 WED%d v1 (TX-only, irq=%d)\n",
+		 hw->index, hw->irq);
+
+	mutex_unlock(&airoha_wed_lock);
+	return 0;
+
+err_detach:
+	dev_err(hw->dev, "failed to attach AN7581 WED%d: %d\n", hw->index, ret);
+	__airoha_wed_detach(dev);
+unlock:
+	mutex_unlock(&airoha_wed_lock);
+	return ret;
+}
+
+static const struct mtk_wed_ops airoha_wed_ops = {
+	.attach = airoha_wed_attach,
+	.tx_ring_setup = airoha_wed_tx_ring_setup,
+	.rx_ring_setup = airoha_wed_rx_ring_setup,
+	.txfree_ring_setup = airoha_wed_txfree_ring_setup,
+	.msg_update = airoha_wed_msg_update,
+	.detach = airoha_wed_detach,
+	.ppe_check = airoha_wed_ppe_check,
+	.stop = airoha_wed_stop,
+	.start = airoha_wed_start,
+	.reset_dma = airoha_wed_reset_dma,
+	.reg_read = airoha_wed_r32,
+	.reg_write = airoha_wed_w32,
+	.irq_get = airoha_wed_irq_get,
+	.irq_set_mask = airoha_wed_irq_set_mask,
+	.setup_tc = airoha_wed_setup_tc,
+	.flow_flush = airoha_wed_flow_flush,
+	.flow_idle = airoha_wed_flow_idle,
+};
+
+bool airoha_wed_is_active(struct airoha_eth *eth, u8 idx)
+{
+	struct mtk_wed_hw *hw;
+
+	if (idx >= AIROHA_WED_MAX_DEVS)
+		return false;
+
+	hw = READ_ONCE(airoha_wed_hw_list[idx]);
+	return hw && hw->eth == eth && READ_ONCE(hw->wed_dev);
+}
+
+static int airoha_wed_add_hw(struct airoha_eth *eth, struct device_node *wed_np,
+			     int fallback_idx)
+{
+	struct device_node *wdma_np;
+	struct resource res_wed, res_wdma;
+	struct mtk_wed_hw *hw;
+	u32 idx = fallback_idx;
+	int irq, err;
+
+	of_property_read_u32(wed_np, "airoha,wed-id", &idx);
+	if (idx >= AIROHA_WED_MAX_DEVS || airoha_wed_hw_list[idx])
+		return -EINVAL;
+
+	wdma_np = of_parse_phandle(wed_np, "airoha,wdma", 0);
+	if (!wdma_np)
+		return -ENODEV;
+
+	err = of_address_to_resource(wed_np, 0, &res_wed);
+	if (err)
+		goto err_put_wdma;
+
+	err = of_address_to_resource(wdma_np, 0, &res_wdma);
+	if (err)
+		goto err_put_wdma;
+
+	irq = irq_of_parse_and_map(wed_np, 0);
+	if (!irq) {
+		err = -EINVAL;
+		goto err_put_wdma;
+	}
+
+	hw = devm_kzalloc(eth->dev, sizeof(*hw), GFP_KERNEL);
+	if (!hw) {
+		err = -ENOMEM;
+		goto err_put_wdma;
+	}
+
+	hw->wed_regs = devm_ioremap_resource(eth->dev, &res_wed);
+	if (IS_ERR(hw->wed_regs)) {
+		err = PTR_ERR(hw->wed_regs);
+		goto err_put_wdma;
+	}
+
+	hw->wdma_regs = devm_ioremap_resource(eth->dev, &res_wdma);
+	if (IS_ERR(hw->wdma_regs)) {
+		err = PTR_ERR(hw->wdma_regs);
+		goto err_put_wdma;
+	}
+
+	hw->eth = eth;
+	hw->dev = eth->dev;
+	hw->wdma_phys = res_wdma.start;
+	hw->index = idx;
+	hw->irq = irq;
+	if (idx == 0) {
+		hw->pcie_cfg_base = AIROHA_WED_PCIE_CFG_BASE_WED0;
+		hw->wdma_ofs0 = AIROHA_WED_WDMA_OFFSET0_WED0;
+		hw->wdma_ofs1 = AIROHA_WED_WDMA_OFFSET1_WED0;
+	} else {
+		hw->pcie_cfg_base = AIROHA_WED_PCIE_CFG_BASE_WED1;
+		hw->wdma_ofs0 = AIROHA_WED_WDMA_OFFSET0_WED1;
+		hw->wdma_ofs1 = AIROHA_WED_WDMA_OFFSET1_WED1;
+	}
+
+	airoha_wed_hw_list[idx] = hw;
+	of_node_put(wdma_np);
+
+	dev_info(eth->dev, "registered AN7581 WED%u (%pR, WDMA %pR, irq=%d)\n",
+		 idx, &res_wed, &res_wdma, irq);
+	return 0;
+
+err_put_wdma:
+	of_node_put(wdma_np);
+	return err;
+}
+
+int airoha_wed_init(struct airoha_eth *eth)
+{
+	struct device_node *np = eth->dev->of_node;
+	struct device_node *wed_np;
+	int i, count = 0;
+
+	if (!airoha_is_7581(eth))
+		return 0;
+
+	mutex_lock(&airoha_wed_lock);
+
+	for (i = 0; i < AIROHA_WED_MAX_DEVS; i++) {
+		wed_np = of_parse_phandle(np, "airoha,wed", i);
+		if (!wed_np)
+			break;
+
+		if (of_device_is_available(wed_np) &&
+		    !airoha_wed_add_hw(eth, wed_np, i))
+			count++;
+
+		of_node_put(wed_np);
+	}
+
+	if (count > 0)
+		rcu_assign_pointer(mtk_soc_wed_ops, &airoha_wed_ops);
+
+	mutex_unlock(&airoha_wed_lock);
+
+	return 0;
+}
+
+void airoha_wed_deinit(struct airoha_eth *eth)
+{
+	bool any_left = false;
+	int i;
+
+	mutex_lock(&airoha_wed_lock);
+
+	for (i = 0; i < AIROHA_WED_MAX_DEVS; i++) {
+		if (airoha_wed_hw_list[i] &&
+		    airoha_wed_hw_list[i]->eth == eth) {
+			airoha_wed_hw_list[i] = NULL;
+		} else if (airoha_wed_hw_list[i]) {
+			any_left = true;
+		}
+	}
+
+	if (!any_left &&
+	    rcu_access_pointer(mtk_soc_wed_ops) == &airoha_wed_ops) {
+		rcu_assign_pointer(mtk_soc_wed_ops, NULL);
+		synchronize_rcu();
+	}
+
+	mutex_unlock(&airoha_wed_lock);
+}
