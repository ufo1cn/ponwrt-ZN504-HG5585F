+				u8 nbq = ((info.idx & 0x1) << 1) |
+					 (info.queue & 0x1);
+
+				/*
+				 * AN7581 WED v1 direct WDMA TX offload:
+				 * PSE port 3 (GDM3/WDMA), PSE_QOS=1, nbq=0..3,
+				 * channel=6+nbq, shaper_id=0x7f, and
+				 * etype=((wcid & 0xff) << 6) | (bss & 0x3f).
+				 */
+				val |= FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT,
+						  FE_PSE_PORT_GDM3) |
+				       FIELD_PREP(AIROHA_FOE_IB2_NBQ, nbq) |
+				       AIROHA_FOE_IB2_PSE_QOS;
+				qdata &= ~AIROHA_FOE_QID;
+				qdata |= FIELD_PREP(AIROHA_FOE_CHANNEL,
+						    6 + nbq);
+				wlan_etype =
+					FIELD_PREP(AIROHA_FOE_MAC_WED_WCID,
+						   info.wcid & 0xff) |
+					FIELD_PREP(AIROHA_FOE_MAC_WED_BSS,
