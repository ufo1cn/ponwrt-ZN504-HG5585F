From: PonWrt <dev@ponwrt.local>
Subject: [PATCH] net: airoha: add AN7581 WED v1 TX-only offload and PPE WDMA encoding

Add a lightweight AN7581 WED v1 TX-only backend (airoha_wed.c) to
airoha-eth that registers mtk_soc_wed_ops for mt76/mt7915e without
requiring mtk_eth_soc. Programs the AN7581-specific WED/WDMA/PCIe
registers (WED+0x560/0x564/0x570/0x57c/0x580, WED+0xaa0/0xaa4/0xaa8,
WDMA+0x204, WPDMA CR mirroring, TX BM init) and forwards setup_tc
to airoha_ppe_dev_setup_tc_block_cb().

Update airoha_ppe_foe_entry_prepare() to emit the AN7581 WED v1 direct
WDMA FOE encoding (fport=3, ib2[9]=1, nbq=(wed_idx<<1)|ring_idx,
qdata[15:11]=6+nbq, shaper_id=0x7f, l2->etype=((wcid&0xff)<<6)|(bss&0x3f))
when WED is active on the target WDMA index, while preserving the
existing CDM4 NPU path for MT7996/MT7992.

---
diff --git a/drivers/net/ethernet/airoha/Makefile b/drivers/net/ethernet/airoha/Makefile
index 9446805..f98e51d 100644
--- a/drivers/net/ethernet/airoha/Makefile
+++ b/drivers/net/ethernet/airoha/Makefile
@@ -6,4 +6,5 @@
 obj-$(CONFIG_NET_AIROHA) += airoha-eth.o
 airoha-eth-y := airoha_eth.o airoha_ppe.o
 airoha-eth-$(CONFIG_DEBUG_FS) += airoha_ppe_debugfs.o
+airoha-eth-$(CONFIG_NET_MEDIATEK_SOC_WED) += airoha_wed.o
 obj-$(CONFIG_NET_AIROHA_NPU) += airoha_npu.o
diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 303596e..3c317f0 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -4944,6 +4944,10 @@ static int airoha_probe(struct platform_device *pdev)
 	if (err)
 		goto error_napi_stop;
 
+	err = airoha_wed_init(eth);
+	if (err)
+		dev_warn(eth->dev, "AN7581 WED init skipped: %d\n", err);
+
 	return 0;
 
 error_napi_stop:
@@ -5015,6 +5019,7 @@ static void airoha_remove(struct platform_device *pdev)
 		}
 		airoha_metadata_dst_free(port);
 	}
+	airoha_wed_deinit(eth);
 	airoha_hw_cleanup(eth);
 
 	free_netdev(eth->napi_dev);
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
index fddbe36..caf5b35 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -314,6 +314,10 @@ enum {
 #define AIROHA_FOE_MAC_WDMA_BAND	BIT(11)
 #define AIROHA_FOE_MAC_WDMA_WCID	GENMASK(10, 0)
 
+/* AN7581 WED v1 direct WDMA (fport=3) l2->etype layout */
+#define AIROHA_FOE_MAC_WED_WCID		GENMASK(13, 6)
+#define AIROHA_FOE_MAC_WED_BSS		GENMASK(5, 0)
+
 struct airoha_foe_mac_info_common {
 	u16 vlan1;
 	u16 etype;
@@ -872,4 +876,24 @@ static inline int airoha_ppe_debugfs_init(struct airoha_ppe *ppe)
 }
 #endif
 
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_SOC_WED)
+int airoha_wed_init(struct airoha_eth *eth);
+void airoha_wed_deinit(struct airoha_eth *eth);
+bool airoha_wed_is_active(struct airoha_eth *eth, u8 idx);
+#else
+static inline int airoha_wed_init(struct airoha_eth *eth)
+{
+	return 0;
+}
+
+static inline void airoha_wed_deinit(struct airoha_eth *eth)
+{
+}
+
+static inline bool airoha_wed_is_active(struct airoha_eth *eth, u8 idx)
+{
+	return false;
+}
+#endif
+
 #endif /* AIROHA_ETH_H */
diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
index 360ae3a..0fe744e 100644
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -317,6 +317,7 @@ static int airoha_ppe_get_wdma_info(struct net_device *dev, const u8 *addr,
 		return -EINVAL;
 
 	info->idx = path->mtk_wdma.wdma_idx;
+	info->queue = path->mtk_wdma.queue;
 	info->bss = path->mtk_wdma.bss;
 	info->wcid = path->mtk_wdma.wcid;
 
@@ -471,14 +472,41 @@ static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 
 		if (!airoha_ppe_get_wdma_info(netdev, data->eth.h_dest,
 					      &info)) {
-			val |= FIELD_PREP(AIROHA_FOE_IB2_NBQ, info.idx) |
-			       FIELD_PREP(AIROHA_FOE_IB2_PSE_PORT,
-					  FE_PSE_PORT_CDM4);
-			qdata |= FIELD_PREP(AIROHA_FOE_ACTDP, info.bss);
-			wlan_etype = FIELD_PREP(AIROHA_FOE_MAC_WDMA_BAND,
-						info.idx) |
-				     FIELD_PREP(AIROHA_FOE_MAC_WDMA_WCID,
